<UserControl
    x:Class="OmniPlay.UI.Views.Library.PosterWallView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:brand="using:OmniPlay.UI.Controls.Brand"
    xmlns:converters="using:OmniPlay.UI.Converters"
    xmlns:layout="using:OmniPlay.UI.Controls.Layout"
    xmlns:player="using:OmniPlay.UI.Controls.Player">
  <UserControl.Resources>
    <converters:ImagePathToBitmapConverter x:Key="ImagePathToBitmapConverter" />
    <!-- 文件夹详情页年表的一行：年份标签 + 《片名》评分（库内作品加粗高亮） -->
    <DataTemplate x:Key="FolderBioRowTemplate">
      <Grid ColumnDefinitions="34,*" Margin="0,1">
        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding YearLabel}" TextAlignment="Right" />
        <Panel Grid.Column="1">
          <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="17" IsVisible="{Binding IsLocal}" />
          <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="17" IsVisible="{Binding IsRemoteOnly}" />
        </Panel>
      </Grid>
    </DataTemplate>
    <!-- 观影状态三态图标：已看 = 强调色实心圆 + 对勾；未看完 = 左半实心；未看 = 圆环 + 播放三角 -->
    <ControlTemplate x:Key="WatchStateGlyphTemplate" TargetType="ContentControl">
      <Panel Width="18" Height="18">
        <Panel IsVisible="{Binding IsWatchedState}">
          <Ellipse Width="17" Height="17" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Path Width="10" Height="10" Stretch="Uniform" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Data="m5 12 5 5 9-11" />
        </Panel>
        <Panel IsVisible="{Binding IsInProgressState}">
          <Ellipse Width="17" Height="17" Stroke="{DynamicResource TextFaintBrush}" StrokeThickness="1.9" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Path Width="18" Height="18" Fill="{DynamicResource TextFaintBrush}" Data="M9,2.2 A6.8,6.8 0 0 0 9,15.8 Z" />
        </Panel>
        <Panel IsVisible="{Binding IsUnwatchedState}">
          <Ellipse Width="17" Height="17" Stroke="{DynamicResource TextFaintBrush}" StrokeThickness="1.7" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>
      </Panel>
    </ControlTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- 全局去焦点框 -->
    <Style Selector="Button">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    
    <!-- 强制浅色背景层 -->
    <Style Selector="Border.homeSurface">
      <Setter Property="Background" Value="{DynamicResource PageBackgroundBrush}" />
    </Style>
    <Style Selector="Border.detailSurface">
      <Setter Property="Background" Value="{DynamicResource DetailSurfaceBrush}" />
    </Style>
    
    <Style Selector="Border.toolbarGroup"><Setter Property="Background" Value="#00000000" /><Setter Property="Padding" Value="0" /></Style>
    <Style Selector="Border.sectionDivider"><Setter Property="Background" Value="{DynamicResource SurfaceBorderBrush}" /><Setter Property="Height" Value="1" /></Style>
    
    <!-- 海报卡片样式 -->
    <Style Selector="Border.posterShell">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="BoxShadow" Value="0 4 14 0 #1A000000" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    </Style>
    <Style Selector="Border.posterShell:pointerover">
      <Setter Property="BoxShadow" Value="0 10 26 0 #30000000" />
    </Style>
    <Style Selector="Border.ratingBadge">
      <Setter Property="Background" Value="#E6FFFFFF" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    
    <!-- 观看状态图标 -->
    
    <Style Selector="Button.watchStateButton">
      <Setter Property="Background" Value="#00000000" /><Setter Property="BorderBrush" Value="#00000000" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="CornerRadius" Value="15" /><Setter Property="Padding" Value="0" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.watchStateButton:pointerover"><Setter Property="Background" Value="#0D000000" /></Style>
    <Style Selector="Button.watchStateButton:pressed"><Setter Property="Background" Value="#1A000000" /></Style>
    
    <Style Selector="Border.detailMetaBadge"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="10,5" /></Style>
    
    <!-- ====== 精美重绘的线框图标规范 ====== -->
    <Style Selector="Path.iconStroke">
      <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="Path.iconFill">
      <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    
    <!-- 详情页圆形返回按钮 -->
    <Style Selector="Button.iconCircle">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" /><Setter Property="CornerRadius" Value="22" /><Setter Property="Padding" Value="0" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.iconCircle:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceBorderBrush}" /></Style>
    <Style Selector="Button.iconCircle:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceBorderStrongBrush}" /></Style>

    <!-- 精致的流式按钮底座（带微阴影） -->
    <Style Selector="Button.flatIcon">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="0 2 4 0 #0A000000">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.flatIcon:pointerover">
      <Setter Property="Background" Value="{DynamicResource PageBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderStrongBrush}" />
    </Style>
    <Style Selector="Button.flatIcon:pointerover /template/ Border">
      <Setter Property="BoxShadow" Value="0 4 8 0 #14000000" />
    </Style>
    <Style Selector="Button.flatIcon:pointerover Path.iconStroke">
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>
    
    <!-- 海报快捷操作按钮 (浅色磨玻璃) -->
    <Style Selector="Button.posterQuickAction">
      <Setter Property="Background" Value="#D9FFFFFF" /><Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="0" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.posterQuickAction:pointerover"><Setter Property="Background" Value="#FFFFFFFF" /><Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderStrongBrush}" /></Style>
    <Style Selector="Button.posterQuickAction Path">
      <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.posterQuickActions"><Setter Property="Opacity" Value="0" /><Setter Property="IsHitTestVisible" Value="False" /></Style>
    <Style Selector="Grid.posterInteractive:pointerover StackPanel.posterQuickActions"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></Style>

    <Style Selector="Button.offlineCacheAction">
      <Setter Property="Background" Value="#B3000000" />
      <Setter Property="BorderBrush" Value="#66FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="64" />
      <Setter Property="CornerRadius" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.offlineCacheAction:pointerover"><Setter Property="Background" Value="#CC000000" /><Setter Property="BorderBrush" Value="#FFFFFFFF" /></Style>
    <Style Selector="TextBlock.offlineCacheGlyph"><Setter Property="Foreground" Value="{DynamicResource MediaOverlayBrush}" /><Setter Property="FontSize" Value="30" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="ProgressBar.offlineCacheProgress"><Setter Property="Height" Value="5" /><Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="1" /></Style>
    <Style Selector="ProgressBar.continueWatchingProgress"><Setter Property="Height" Value="4" /><Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="1" /><Setter Property="Foreground" Value="#0078D4" /><Setter Property="Background" Value="#D8DDE3" /></Style>
    
    <Style Selector="Button.cardButton">
      <Setter Property="Background" Value="#00000000" /><Setter Property="BorderBrush" Value="#00000000" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></Border></ControlTemplate></Setter>
    </Style>
    
    <!-- 主操作按钮 (流畅蓝) -->
    <Style Selector="Button.heroAction">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="20,9" /><Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="16" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.heroAction:pointerover"><Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" /></Style>
    
    <!-- 次级按钮 (纯白底色) -->
    <Style Selector="Button.heroSecondary">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderStrongBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="16,9" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="15" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.heroSecondary:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" /></Style>
    
    <Style Selector="Button.sourceAction">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderStrongBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="14,8" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.sourceAction:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" /></Style>
    
    <Style Selector="Button.networkLinkAction">
      <Setter Property="Background" Value="#00000000" /><Setter Property="BorderBrush" Value="#00000000" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.networkLinkAction:pointerover"><Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" /></Style>
    
    <Style Selector="Button.sortOption">
      <Setter Property="Background" Value="#00000000" /><Setter Property="BorderBrush" Value="#00000000" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="12,10" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="CornerRadius" Value="6" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.sortOption:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" /></Style>
    
    <!-- 弹出浮层 (干净纯白) -->
    <Style Selector="Border.popupPanel"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="BoxShadow" Value="0 8 24 0 #1A000000" /></Style>
    
    <Style Selector="TextBox.popupSearchBox"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="12,8" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
    <Style Selector="ComboBox.popupSelect"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="12,8" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
    <!-- 统一输入控件圆角 -->
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="6" /></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="6" /></Style>
    
    <Style Selector="Button.dangerAction">
      <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="12,8" /><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.dangerAction:pointerover"><Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" /></Style>
    
    <!-- 媒体源行图标按钮 -->
    <Style Selector="Button.sourceIconButton">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderStrongBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="0" /><Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.sourceIconButton:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" /></Style>
    <Style Selector="Button.sourceIconButton:pointerover Path.iconStroke"><Setter Property="Stroke" Value="{DynamicResource AccentBrush}" /></Style>
    <Style Selector="Button.sourceIconButton.danger"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" /></Style>
    <Style Selector="Button.sourceIconButton.danger Path.iconStroke"><Setter Property="Stroke" Value="{DynamicResource DangerBrush}" /></Style>
    <Style Selector="Button.sourceIconButton.danger:pointerover"><Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" /></Style>
    <Style Selector="Button.sourceIconButton:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
    
    <!-- 播放页悬浮按钮高级样式 -->
    <Style Selector="Button.overlayCtrl">
      <Setter Property="Background" Value="#4D000000" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.overlayCtrl:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#80000000" />
    </Style>

    <!-- 播放页 Win11 窗口按钮样式 -->
    <Style Selector="Button.WinCaptionBtnOverlay">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="Button.WinCaptionBtnOverlay:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF"/>
    </Style>
    <Style Selector="Button.WinCloseBtnOverlay:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E81123"/>
    </Style>
    <Style Selector="Border.overlayResizeGrip">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.overlayResizeGrip:pointerover">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.overlayResizeGrip:pressed">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- 进度条 -->
    <Style Selector="Border.progressTrack"><Setter Property="Background" Value="{DynamicResource SurfaceBorderBrush}" /><Setter Property="CornerRadius" Value="3" /><Setter Property="Height" Value="6" /></Style>
    <Style Selector="ProgressBar.libraryProgress"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceBorderBrush}" /><Setter Property="Height" Value="4" /><Setter Property="CornerRadius" Value="2" /></Style>
    
    <Style Selector="Border.detailPanel"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="BoxShadow" Value="0 4 12 0 #0D000000" /></Style>

    <!-- Toast 通知 -->
    <Style Selector="Border.toastCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BoxShadow" Value="0 10 28 0 #24000000" />
    </Style>
    <Style Selector="TextBlock.toastText"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>

    <!-- 海报墙加载骨架 -->
    <Style Selector="Border.skeletonCard"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" /><Setter Property="CornerRadius" Value="6" /></Style>
    <Style Selector="Border.skeletonBar"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" /><Setter Property="CornerRadius" Value="4" /></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <!-- 主页海报墙 -->
    <Border Grid.Row="0" Classes="homeSurface" IsVisible="{Binding !IsDetailOpen}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="HomeContentStack" Margin="52,52,52,40" Spacing="6">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <!-- 所有提示信息统一显示在左上角，并且只占一行 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,0,16,0" Spacing="12">
              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding HomeStatusMessage}" TextTrimming="CharacterEllipsis" MaxWidth="520" VerticalAlignment="Center" IsVisible="{Binding HasStatusMessage}" />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowOfflineCacheTopBar}">
                <ProgressBar Classes="libraryProgress" Width="120" VerticalAlignment="Center" Value="{Binding OfflineCacheTopBarProgress}" />
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding OfflineCacheTopBarTitle}" TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center" />
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Text="{Binding OfflineCacheTopBarDetail}" TextTrimming="CharacterEllipsis" MaxWidth="200" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Classes="toolbarGroup">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="SourceButton" Classes="flatIcon" Command="{Binding ToggleSourcePopupCommand}" ToolTip.Tip="{DynamicResource L060}">
                  <Path Classes="iconStroke" Width="20" Height="20" Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                </Button>
                <Button Classes="flatIcon" Command="{Binding ScanCommand}" ToolTip.Tip="{DynamicResource L082}">
                  <Path Classes="iconStroke" Width="20" Height="20" Data="M21 3v5h-5 M3 21v-5h5 M3.5 9a9 9 0 0 1 14.5-3.5L21 8 M20.5 15a9 9 0 0 1-14.5 3.5L3 16" />
                </Button>
                <Button Classes="flatIcon" Command="{Binding ToggleOfflineCacheModeCommand}" ToolTip.Tip="{DynamicResource L129}">
                  <Path Classes="iconStroke" Width="20" Height="20" Data="M12 3v12m0 0l-5-5m5 5l5-5 M5 21h14" />
                </Button>
                <Button x:Name="SettingsButton" Classes="flatIcon" Command="{Binding ToggleSettingsPopupCommand}" ToolTip.Tip="{DynamicResource L147}">
                  <Path Classes="iconStroke" Width="20" Height="20" Data="M12 9a3 3 0 1 0 0 6 3 3 0 1 0 0-6z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
                </Button>
              </StackPanel>
            </Border>
          </Grid>

          <Popup IsLightDismissEnabled="True" IsOpen="{Binding IsSearchPopupOpen, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding #SearchButton}">
            <Border Classes="popupPanel" Width="340" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L090}" />
                <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L161}" Text="{Binding SearchText}" />
              </StackPanel>
            </Border>
          </Popup>

          <Popup IsLightDismissEnabled="True" IsOpen="{Binding IsSortPopupOpen, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding #SortButton}">
            <Border Classes="popupPanel" Width="220" Padding="12">
              <StackPanel Spacing="6">
                <TextBlock Margin="8,4,8,8" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L088}" />
                <ItemsControl ItemsSource="{Binding SortOptions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="sortOption" Command="{Binding $parent[UserControl].DataContext.SelectSortOptionCommand}" CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="20,*">
                          <TextBlock Grid.Column="0" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="✓" IsVisible="{Binding IsSelected}" />
                          <TextBlock Grid.Column="1" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Label}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Popup>

          <Popup IsLightDismissEnabled="True" IsOpen="{Binding IsHomeCategoryMenuOpen, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding #CategoryButton}">
            <Border Classes="popupPanel" Width="200" Padding="12">
              <StackPanel Spacing="6">
                <TextBlock Margin="8,4,8,8" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L037}" />
                <Button Classes="sortOption" Command="{Binding $parent[UserControl].DataContext.SelectHomeCategoryCommand}" CommandParameter="none">
                  <Grid ColumnDefinitions="20,*">
                    <TextBlock Grid.Column="0" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="✓" IsVisible="{Binding $parent[UserControl].DataContext.IsHomeCategoryNoneSelected}" />
                    <TextBlock Grid.Column="1" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" Text="{DynamicResource L013}" />
                  </Grid>
                </Button>
                <Button Classes="sortOption" Command="{Binding $parent[UserControl].DataContext.SelectHomeCategoryCommand}" CommandParameter="director">
                  <Grid ColumnDefinitions="20,*">
                    <TextBlock Grid.Column="0" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="✓" IsVisible="{Binding $parent[UserControl].DataContext.IsHomeCategoryDirectorSelected}" />
                    <TextBlock Grid.Column="1" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" Text="{DynamicResource L086}" />
                  </Grid>
                </Button>
                <Button Classes="sortOption" Command="{Binding $parent[UserControl].DataContext.SelectHomeCategoryCommand}" CommandParameter="actor">
                  <Grid ColumnDefinitions="20,*">
                    <TextBlock Grid.Column="0" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="✓" IsVisible="{Binding $parent[UserControl].DataContext.IsHomeCategoryActorSelected}" />
                    <TextBlock Grid.Column="1" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" Text="{DynamicResource L085}" />
                  </Grid>
                </Button>
              </StackPanel>
            </Border>
          </Popup>

          <Popup IsLightDismissEnabled="True" IsOpen="{Binding IsSourcePopupOpen, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding #SourceButton}">
            <Border Classes="popupPanel" Width="560" MaxHeight="760" Padding="20">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L068}" />
                  <StackPanel Spacing="10">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" IsVisible="{Binding !HasMediaSources}">
                      <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,12,0,12">
                        <Path Width="28" Height="28" Stretch="Uniform" Stroke="{DynamicResource TextFaintBrush}" StrokeThickness="1.7" StrokeLineCap="Round" Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Text="{DynamicResource L101}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" Text="{DynamicResource L118}" />
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding MediaSources}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="24,*,Auto,Auto" RowDefinitions="Auto,Auto">
                              <StackPanel Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.7" StrokeLineCap="Round" IsVisible="{Binding IsLuckySourceKind}" Data="M8 3L4 7l4 4 M4 7h16 M16 21l4-4-4-4 M20 17H4" />
                                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.7" StrokeLineCap="Round" IsVisible="{Binding IsWebDavSourceKind}" Data="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9z" />
                                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.7" StrokeLineCap="Round" IsVisible="{Binding IsSmbSourceKind}" Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M2 12h20 M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.7" StrokeLineCap="Round" IsVisible="{Binding IsLocalSourceKind}" Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.7" StrokeLineCap="Round" IsVisible="{Binding IsServerSourceKind}" Data="M2 7h20v13H2z M17 2l-5 5-5-5" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" FontSize="15" FontWeight="SemiBold" Opacity="{Binding RowOpacity}" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding DisplayNameWithType}" TextTrimming="CharacterEllipsis" />
                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0">
                                <Button Classes="sourceIconButton" Command="{Binding $parent[UserControl].DataContext.RefreshAndCheckLuckyStunSourceCommand}" CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource L043}" IsVisible="{Binding HasLuckyStunSourceConfig}">
                                  <Path Classes="iconStroke" Width="15" Height="15" Data="M23 4v6h-6 M1 20v-6h6 M3.51 9a9 9 0 0 1 14.85-3.36L23 10 M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
                                </Button>
                                <Button Classes="sourceIconButton" Command="{Binding $parent[UserControl].DataContext.EditLuckyStunSourceCommand}" CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource L139}" IsVisible="{Binding HasLuckyStunSourceConfig}">
                                  <Path Classes="iconStroke" Width="15" Height="15" Data="M12 20h9 M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                                </Button>
                                <Button Classes="sourceIconButton" Command="{Binding $parent[UserControl].DataContext.CheckSourceConnectivityCommand}" CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource L110}" IsVisible="{Binding !HasLuckyStunSourceConfig}">
                                  <Path Classes="iconStroke" Width="15" Height="15" Data="M22 12h-4l-3 9L9 3l-3 9H2" />
                                </Button>
                                <Button Classes="sourceIconButton" Command="{Binding $parent[UserControl].DataContext.ToggleSourceEnabledCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding ToggleActionText}">
                                  <Grid Width="15" Height="15">
                                    <Path Classes="iconStroke" Width="15" Height="15" Stroke="#34D399" IsVisible="{Binding IsEnabled}" Data="M18.36 6.64a9 9 0 1 1-12.73 0 M12 2v10" />
                                    <Path Classes="iconStroke" Width="15" Height="15" Stroke="#94A3B8" IsVisible="{Binding !IsEnabled}" Data="M18.36 6.64a9 9 0 1 1-12.73 0 M12 2v10" />
                                  </Grid>
                                </Button>
                              </StackPanel>
                              <Button Grid.Column="3" Classes="sourceIconButton danger" Command="{Binding $parent[UserControl].DataContext.OpenRemoveSourceConfirmationCommand}" CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource L130}">
                                <Path Classes="iconStroke" Width="15" Height="15" Data="M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M10 11v6 M14 11v6" />
                              </Button>
                              <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Opacity="0.62" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding DisplayAddress}" TextWrapping="Wrap" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>


                  <StackPanel Spacing="10">
                    <Button Classes="sourceAction" Command="{Binding AddFolderSourceCommand}" Content="{DynamicResource L117}" />
                    <Button Classes="sourceAction" Command="{Binding OpenManualNetworkLoginCommand}" Content="{DynamicResource L116}" />
                    <Button Classes="sourceAction" Command="{Binding OpenLuckyStunSourcePanelCommand}" Content="{DynamicResource L114}" />
                  </StackPanel>
                  <Border Height="1" Background="{DynamicResource SurfaceBorderBrush}" />

                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L171}" />
                      <Button Grid.Column="1" Classes="sourceAction" Command="{Binding RefreshNetworkSourcesCommand}" Content="{DynamicResource L167}" />
                    </Grid>
                    <TextBlock Opacity="0.62" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{Binding NetworkSourceStatus}" />
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" IsVisible="{Binding !HasDiscoveredNetworkSources}">
                      <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,12,0,12">
                        <Path Width="28" Height="28" Stretch="Uniform" Stroke="{DynamicResource TextFaintBrush}" StrokeThickness="1.7" StrokeLineCap="Round" Data="M21 3v5h-5 M3 21v-5h5 M3.5 9a9 9 0 0 1 14.5-3.5L21 8 M20.5 15a9 9 0 0 1-14.5 3.5L3 16" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Text="{DynamicResource L102}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" Text="{DynamicResource L105}" />
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding DiscoveredNetworkSources}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                              <Button Grid.Column="0" Classes="networkLinkAction" Command="{Binding $parent[UserControl].DataContext.OpenNetworkLoginCommand}" CommandParameter="{Binding}">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                              </Button>
                              <TextBlock Grid.Column="1" Opacity="0.68" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding ProtocolLabel}" />
                              <Button Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Classes="networkLinkAction" HorizontalAlignment="Left" Command="{Binding $parent[UserControl].DataContext.OpenNetworkLoginCommand}" CommandParameter="{Binding}">
                                <TextBlock FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding BaseUrl}" TextWrapping="Wrap" />
                              </Button>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Popup>

          <Popup IsLightDismissEnabled="True" IsOpen="{Binding IsSettingsPopupOpen, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding #SettingsButton}">
            <Border Classes="popupPanel" Width="460" MaxHeight="720" Padding="20">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L147}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="heroAction" Command="{Binding Settings.SaveCommand}" Content="{DynamicResource L030}" Padding="18,9" FontSize="15" HorizontalAlignment="Right" />
                  </Grid>

                  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                      <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L159}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{DynamicResource L075}" />
                        <TextBlock Opacity="0.72" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Settings.AppVersionText}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <CheckBox Foreground="{DynamicResource TextSecondaryBrush}" IsChecked="{Binding Settings.AutoCheckUpdatesOnStartup, Mode=TwoWay}" Content="{DynamicResource L056}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="sourceAction" Command="{Binding Settings.CheckForUpdatesCommand}" Content="{DynamicResource L109}" />
                        <Button Classes="sourceAction" Command="{Binding Settings.InstallLatestUpdateCommand}" Content="{DynamicResource L127}" />
                        <Button Classes="sourceAction" Command="{Binding Settings.OpenGitHubRepositoryCommand}" Content="{DynamicResource L002}" />
                      </StackPanel>
                      <TextBlock Opacity="0.72" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{Binding Settings.UpdateStatusMessage}" />
                    </StackPanel>
                  </Border>

                  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L058}" />
                      <CheckBox Foreground="{DynamicResource TextSecondaryBrush}" IsChecked="{Binding Settings.AutoScanOnStartup, Mode=TwoWay}" Content="{DynamicResource L055}" />
                      <CheckBox Foreground="{DynamicResource TextSecondaryBrush}" IsChecked="{Binding Settings.ShowMediaSourceRealPath, Mode=TwoWay}" Content="{DynamicResource L061}" />
                                            <StackPanel Spacing="8" Margin="0,4,0,0">
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{DynamicResource L123}" />
                        <ComboBox Classes="popupSelect" HorizontalAlignment="Stretch" ItemsSource="{Binding Settings.LanguageOptions}" SelectedItem="{Binding Settings.SelectedLanguageOption, Mode=TwoWay}">
                          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Opacity="0.66" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{DynamicResource L041}" />
                      </StackPanel>
                      <StackPanel Spacing="8" Margin="0,4,0,0">
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{DynamicResource L122}" />
                        <ComboBox Classes="popupSelect" HorizontalAlignment="Stretch" ItemsSource="{Binding Settings.ThemeOptions}" SelectedItem="{Binding Settings.SelectedThemeOption, Mode=TwoWay}">
                          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Opacity="0.66" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{DynamicResource L040}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  

                  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                      <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L129}" />
                      <TextBlock Opacity="0.72" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{Binding Settings.OfflineCacheDirectory}" />
                      <Button Classes="sourceAction" Command="{Binding ChooseOfflineCacheDirectoryCommand}" Content="{DynamicResource L166}" />
                    </StackPanel>
                  </Border>

                  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L106}" />
                      <CheckBox Foreground="{DynamicResource TextSecondaryBrush}" IsChecked="{Binding Settings.EnableLocalMetadataImport, Mode=TwoWay}" Content="{DynamicResource L153}" />
                      <CheckBox Foreground="{DynamicResource TextSecondaryBrush}" IsChecked="{Binding Settings.EnableLocalMetadataExport, Mode=TwoWay}" Content="{DynamicResource L042}" />
                      <TextBlock Opacity="0.68" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{DynamicResource L172}" />
                    </StackPanel>
                  </Border>

                  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="14">
                      <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L142}" />
                        <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L001}" Text="{Binding Settings.CustomTmdbCredential, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Classes="linkAction" HorizontalAlignment="Left" Command="{Binding Settings.OpenTmdbWebsiteCommand}" Content="{DynamicResource L150}" />
                      </StackPanel>
                      <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L007}" />
                        <TextBlock Opacity="0.68" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{DynamicResource L097}" />
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="4">
                          <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Margin="10,0,6,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Text="&#xE774;" />
                            <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="4,8,12,8" Classes="popupSearchBox" Watermark="{DynamicResource L124}" Text="{Binding Settings.CustomTmdbProxyUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          </Grid>
                        </Border>
                      </StackPanel>
                      <StackPanel Spacing="10">
                        <TextBlock Opacity="0.72" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{Binding Settings.TmdbConnectionStatusMessage}" />
                        <Button Classes="sourceAction" Command="{Binding Settings.TestTmdbConnectionCommand}" Content="{DynamicResource L111}" />
                      </StackPanel>
                      <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L158}" />
                        <ComboBox Classes="popupSelect" HorizontalAlignment="Stretch" ItemsSource="{Binding Settings.TmdbLanguageOptions}" SelectedItem="{Binding Settings.SelectedTmdbLanguageOption, Mode=TwoWay}">
                          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L094}" />
                      <StackPanel Spacing="8">
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{DynamicResource L174}" />
                        <ComboBox Classes="popupSelect" HorizontalAlignment="Stretch" ItemsSource="{Binding Settings.DefaultAudioTrackOptions}" SelectedItem="{Binding Settings.SelectedDefaultAudioTrackOption, Mode=TwoWay}">
                          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Spacing="8">
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{DynamicResource L173}" />
                        <ComboBox Classes="popupSelect" HorizontalAlignment="Stretch" ItemsSource="{Binding Settings.DefaultSubtitleTrackOptions}" SelectedItem="{Binding Settings.SelectedDefaultSubtitleTrackOption, Mode=TwoWay}">
                          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                      <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L095}" />
                      <TextBlock Opacity="0.72" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{Binding Player.BackendName}" />
                      <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" Text="{DynamicResource L074}" />
                      <ItemsControl ItemsSource="{Binding Settings.CreditLinks}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto,Auto">
                              <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Margin="10,0,0,0" Opacity="0.62" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding License}" />
                              <Button Grid.Column="2" Margin="8,0,0,0" Classes="sourceAction" Padding="10,6" Command="{Binding $parent[UserControl].DataContext.Settings.OpenCreditLinkCommand}" CommandParameter="{Binding}" Content="{DynamicResource L140}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="sourceAction" Command="{Binding Settings.OpenAboutCommand}" Content="{DynamicResource L032}" />
                        <Button Classes="sourceAction" Command="{Binding Settings.OpenThirdPartyNoticesCommand}" Content="{DynamicResource L133}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <TextBlock Foreground="#A0A0A0" TextWrapping="Wrap" Text="{Binding Settings.StatusMessage}" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Popup>

          <Popup IsLightDismissEnabled="True" IsOpen="{Binding Settings.IsAboutPopupOpen}" Placement="Bottom" PlacementTarget="{Binding #SettingsButton}">
            <Border Classes="popupPanel" Width="560" MaxHeight="780" Padding="20">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                      <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L033}" />
                      <TextBlock Opacity="0.68" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{DynamicResource L011}" />
                    </StackPanel>
                    <Button Grid.Column="1" Margin="12,0,0,0" Classes="sourceAction" Command="{Binding Settings.CloseAboutCommand}" Content="{DynamicResource L035}" VerticalAlignment="Top" />
                  </Grid>

                  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                      <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L072}" />
                      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="6">
                          <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L145}" />
                          <TextBlock Opacity="0.74" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Settings.AppVersionText, StringFormat=版本 {0}}" />
                          <TextBlock Opacity="0.68" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{Binding Settings.RuntimeText}" />
                          <TextBlock Opacity="0.68" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{Binding Settings.PlatformText}" />
                          <TextBlock Opacity="0.58" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{Binding Settings.SettingsDirectoryPath, StringFormat=设置目录：{0}}" />
                          <TextBlock Opacity="0.58" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{Binding Settings.ThirdPartyNoticesPath, StringFormat=第三方声明：{0}}" />
                          <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Spacing="8">
                            <Button Classes="sourceAction" Command="{Binding Settings.OpenSettingsDirectoryCommand}" Content="{DynamicResource L081}" />
                            <Button Classes="sourceAction" Command="{Binding Settings.OpenThirdPartyNoticesCommand}" Content="{DynamicResource L107}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>

                  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                      <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="TMDB Credits" />
                      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                        <StackPanel Spacing="8">
                          <brand:TmdbLogo Height="26" HorizontalAlignment="Left" />
                          <TextBlock Opacity="0.58" Foreground="{DynamicResource TextMutedBrush}" Text="Official approved logo" />
                        </StackPanel>
                      </Border>
                      <Border Background="#FFF6E7" BorderBrush="#F0D7A1" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="6">
                          <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L010}" />
                          <TextBlock Opacity="0.82" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{DynamicResource L009}" />
                          <TextBlock Opacity="0.72" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="This product uses the TMDB API but is not endorsed or certified by TMDB." />
                        </StackPanel>
                      </Border>
                      <TextBlock Opacity="0.62" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{DynamicResource L084}" />
                      <StackPanel Spacing="8">
                        <Button Classes="sourceAction" Command="{Binding Settings.OpenTmdbWebsiteCommand}" Content="{DynamicResource L080}" />
                        <Button Classes="sourceAction" Command="{Binding Settings.OpenTmdbFaqCommand}" Content="{DynamicResource L079}" />
                        <Button Classes="sourceAction" Command="{Binding Settings.OpenTmdbApiTermsCommand}" Content="{DynamicResource L078}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                      <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L073}" />
                      <TextBlock Opacity="0.66" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{DynamicResource L017}" />
                      <ItemsControl ItemsSource="{Binding Settings.CreditLinks}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Margin="0,0,0,10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                              <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Title}" />
                                <TextBlock Opacity="0.68" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{Binding Description}" />
                                <TextBlock Opacity="0.58" Foreground="#888888" Text="{Binding License, StringFormat=许可证：{0}}" />
                                <Button Classes="sourceAction" Command="{Binding $parent[UserControl].DataContext.Settings.OpenCreditLinkCommand}" CommandParameter="{Binding}" Content="{Binding ButtonText}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Popup>

          <StackPanel Margin="0,-18,0,0" Spacing="14" IsVisible="{Binding ShowContinueWatching}">
            <TextBlock FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L136}" />
            <ScrollViewer x:Name="ContinueWatchingScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ContinueWatchingItems}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Width="{Binding $parent[UserControl].LibraryPosterItemWidth}">
                      <!-- 靠左贴齐单元格，卡片间距与海报墙一致 -->
                      <StackPanel Width="{Binding $parent[UserControl].LibraryPosterCardWidth}" HorizontalAlignment="Left" Spacing="0">
                        <Grid Classes="posterInteractive" Width="{Binding $parent[UserControl].LibraryPosterCardWidth}" Height="{Binding $parent[UserControl].LibraryPosterCardHeight}" ClipToBounds="True">
                          <Button Classes="cardButton" Command="{Binding $parent[UserControl].DataContext.OpenDetailCommand}" CommandParameter="{Binding}" IsEnabled="{Binding !$parent[UserControl].DataContext.IsHomeOfflineCacheModeActive}">
                            <Grid Width="{Binding $parent[UserControl].LibraryPosterCardWidth}" Height="{Binding $parent[UserControl].LibraryPosterCardHeight}">
                              <Border Classes="posterShell" />
                              <Rectangle RadiusX="6" RadiusY="6">
                                <Rectangle.Fill><ImageBrush Source="{Binding PosterPath, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="UniformToFill" /></Rectangle.Fill>
                              </Rectangle>
                              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8" Spacing="6">
                                <Border Classes="ratingBadge" IsVisible="{Binding HasTmdbRating}">
                                  <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Path Width="11" Height="11" Stretch="Uniform" Fill="#B45309" Data="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                    <TextBlock Foreground="#B45309" FontSize="13" FontWeight="Bold" Text="{Binding TmdbRatingText}" />
                                  </StackPanel>
                                </Border>
                                <Border Classes="ratingBadge" IsVisible="{Binding HasDoubanRating}">
                                  <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Path Width="11" Height="11" Stretch="Uniform" Fill="#157A33" Data="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                    <TextBlock Foreground="#157A33" FontSize="13" FontWeight="Bold" Text="{Binding DoubanRatingText}" />
                                  </StackPanel>
                                </Border>
                              </StackPanel>
                            </Grid>
                          </Button>
                          <StackPanel Classes="posterQuickActions" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="6" Margin="0,8,8,0">
<Button Classes="posterQuickAction" Command="{Binding $parent[UserControl].DataContext.OpenPosterScrapeCommand}" CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource L092}" IsVisible="{Binding !IsFolder}">
<Path Width="15" Height="15" Data="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
</Button>
<Button Classes="posterQuickAction" Command="{Binding $parent[UserControl].DataContext.OpenPosterEditCommand}" CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource L144}" IsVisible="{Binding !IsFolder}">
<Path Width="15" Height="15" Data="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
</Button>
<Button Classes="posterQuickAction" Command="{Binding $parent[UserControl].DataContext.EditHomeFolderPosterCommand}" CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource L144}" IsVisible="{Binding IsFolder}">
<Path Width="15" Height="15" Data="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
</Button>
                          </StackPanel>
                          <Button Classes="offlineCacheAction" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding $parent[UserControl].DataContext.CachePosterItemCommand}" CommandParameter="{Binding}" IsVisible="{Binding $parent[UserControl].DataContext.IsHomeOfflineCacheModeActive}" ToolTip.Tip="{Binding OfflineCacheTip}">
                            <Grid Width="58" Height="58">
                              <TextBlock Classes="offlineCacheGlyph" Text="{Binding OfflineCacheGlyph}" IsVisible="{Binding ShowOfflineCacheIcon}" />
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="46" Spacing="4" IsVisible="{Binding ShowOfflineCacheProgress}">
                                <TextBlock Foreground="{DynamicResource MediaOverlayBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Text="{Binding OfflineCachePercentText}" />
                                <ProgressBar Classes="offlineCacheProgress" Value="{Binding OfflineCacheProgress}" />
                              </StackPanel>
                            </Grid>
                          </Button>
                        </Grid>
                        <ProgressBar Classes="continueWatchingProgress" Width="{Binding $parent[UserControl].LibraryPosterCardWidth}" Margin="0,8,0,0" Value="{Binding ContinueWatchingProgress}" />
                        <StackPanel Width="{Binding $parent[UserControl].LibraryPosterCardWidth}" Spacing="0">
                          <Button Classes="cardButton" Command="{Binding $parent[UserControl].DataContext.OpenDetailCommand}" CommandParameter="{Binding}" IsEnabled="{Binding !$parent[UserControl].DataContext.IsHomeOfflineCacheModeActive}">
                            <TextBlock Margin="0,10,0,0" Width="{Binding $parent[UserControl].LibraryPosterCardWidth}" MinHeight="34" FontSize="{Binding $parent[UserControl].LibraryPosterTitleFontSize}" FontWeight="SemiBold" LineHeight="21" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Title}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                          </Button>
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Button Classes="cardButton" Command="{Binding $parent[UserControl].DataContext.OpenDetailCommand}" CommandParameter="{Binding}" IsEnabled="{Binding !$parent[UserControl].DataContext.IsHomeOfflineCacheModeActive}">
                              <TextBlock Width="{Binding $parent[UserControl].LibraryPosterSubtitleWidth}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextAlignment="Center" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button Classes="watchStateButton" Command="{Binding $parent[UserControl].DataContext.OpenPosterWatchStateConfirmationCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding WatchStateText}">
                              <ContentControl Template="{StaticResource WatchStateGlyphTemplate}" />
                            </Button>
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>

          <Border Classes="sectionDivider" Margin="0,8,0,6" IsVisible="{Binding ShowContinueWatching}" />

          <StackPanel Spacing="20">
            <!-- 首页标题与工具栏：未进入分类详情时显示 -->
            <Grid ColumnDefinitions="Auto,Auto,*" VerticalAlignment="Top" Margin="0,4,0,0" IsVisible="{Binding !IsHomeFolderOpen}">
              <TextBlock Grid.Column="0" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Text="{DynamicResource L077}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="18,0,0,0" VerticalAlignment="Top">
                <Button x:Name="SearchButton" Classes="flatIcon" Command="{Binding ToggleSearchPopupCommand}" ToolTip.Tip="{DynamicResource L093}">
                  <Path Classes="iconStroke" Width="18" Height="18" Data="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </Button>
                <Button x:Name="SortButton" Classes="flatIcon" Command="{Binding ToggleSortPopupCommand}" ToolTip.Tip="{DynamicResource L089}">
                  <Path Classes="iconStroke" Width="18" Height="18" Data="M4 6h16 M4 12h10 M4 18h4" />
                </Button>
                <Button Classes="flatIcon" Command="{Binding ToggleSortDirectionCommand}" ToolTip.Tip="{Binding SortDirectionToolTip}">
                  <Panel Width="18" Height="18">
                    <Path Classes="iconStroke" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsSortAscending}" Data="M12 19V5m0 0l-6 6m6-6l6 6" />
                    <Path Classes="iconStroke" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsSortDescending}" Data="M12 5v14m0 0l-6-6m6 6l6 6" />
                  </Panel>
                </Button>
                <Button x:Name="CategoryButton" Classes="flatIcon" Command="{Binding ToggleHomeCategoryMenuCommand}" ToolTip.Tip="{DynamicResource L037}">
                  <Path Classes="iconStroke" Width="18" Height="18" Data="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012-2z" />
                </Button>
              </StackPanel>
            </Grid>

            <!-- 分类文件夹详情头部：返回键在人物图正上方居中，六列年表铺满剩余宽度 -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0" IsVisible="{Binding IsHomeFolderOpen}">
              <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,24,0" VerticalAlignment="Top">
                <Button Classes="flatIcon" Command="{Binding CloseHomeFolderCommand}" ToolTip.Tip="{DynamicResource L162}" HorizontalAlignment="Center">
                  <Path Classes="iconStroke" Width="20" Height="20" Data="M19 12H5m0 0l7 7m-7-7l7-7" />
                </Button>
                <Grid Width="{Binding $parent[UserControl].LibraryPosterCardWidth}" Height="{Binding $parent[UserControl].LibraryPosterCardHeight}" ToolTip.Tip="{Binding OpenFolderCoverTip}" IsVisible="{Binding OpenFolderCoverPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <Border Classes="posterShell" CornerRadius="8" />
                  <Rectangle RadiusX="8" RadiusY="8">
                    <Rectangle.Fill><ImageBrush Source="{Binding OpenFolderCoverPath, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="UniformToFill" /></Rectangle.Fill>
                  </Rectangle>
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <TextBlock FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding OpenFolderDisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="13" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding OpenFolderBioHeader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding OpenFolderBioHeader}" TextWrapping="Wrap" LineHeight="19" />
                <Grid ColumnDefinitions="*,*,*,*,*,*" Margin="0,8,0,0" IsVisible="{Binding HasOpenFolderBioRows}">
                  <ItemsControl ItemsSource="{Binding OpenFolderBioColumns[0]}" Margin="0,0,18,0" ItemTemplate="{StaticResource FolderBioRowTemplate}" />
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding OpenFolderBioColumns[1]}" Margin="0,0,18,0" ItemTemplate="{StaticResource FolderBioRowTemplate}" />
                  <ItemsControl Grid.Column="2" ItemsSource="{Binding OpenFolderBioColumns[2]}" Margin="0,0,18,0" ItemTemplate="{StaticResource FolderBioRowTemplate}" />
                  <ItemsControl Grid.Column="3" ItemsSource="{Binding OpenFolderBioColumns[3]}" Margin="0,0,18,0" ItemTemplate="{StaticResource FolderBioRowTemplate}" />
                  <ItemsControl Grid.Column="4" ItemsSource="{Binding OpenFolderBioColumns[4]}" Margin="0,0,18,0" ItemTemplate="{StaticResource FolderBioRowTemplate}" />
                  <ItemsControl Grid.Column="5" ItemsSource="{Binding OpenFolderBioColumns[5]}" ItemTemplate="{StaticResource FolderBioRowTemplate}" />
                </Grid>
                <TextBlock FontSize="13" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding IsOpenFolderFilmographyLoading}" Text="（正在获取完整作品列表…）" />
              </StackPanel>
            </Grid>

              <Border Classes="sectionDivider" Margin="0,10,0,0" IsVisible="{Binding IsHomeFolderOpen}" />

              <ItemsControl x:Name="LibraryItemsControl" Margin="{Binding $parent[UserControl].LibraryWallMargin}" ItemsSource="{Binding LibraryItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="{Binding $parent[UserControl].LibraryPosterItemWidth}" ItemHeight="{Binding $parent[UserControl].LibraryPosterItemHeight}" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Width="{Binding $parent[UserControl].LibraryPosterCardWidth}">
                      <StackPanel Width="{Binding $parent[UserControl].LibraryPosterCardWidth}" Margin="0,0,0,14" Spacing="0">
                        <Grid Classes="posterInteractive" Width="{Binding $parent[UserControl].LibraryPosterCardWidth}" Height="{Binding $parent[UserControl].LibraryPosterCardHeight}" ClipToBounds="True">
                          <Button Classes="cardButton" Command="{Binding $parent[UserControl].DataContext.OpenDetailCommand}" CommandParameter="{Binding}" IsEnabled="{Binding !$parent[UserControl].DataContext.IsHomeOfflineCacheModeActive}">
                            <Grid Width="{Binding $parent[UserControl].LibraryPosterCardWidth}" Height="{Binding $parent[UserControl].LibraryPosterCardHeight}">
                              <Border Classes="posterShell" />
                              <Rectangle RadiusX="6" RadiusY="6">
                                <Rectangle.Fill><ImageBrush Source="{Binding PosterPath, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="UniformToFill" /></Rectangle.Fill>
                              </Rectangle>
                              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8" Spacing="6">
                                <Border Classes="ratingBadge" IsVisible="{Binding HasTmdbRating}">
                                  <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Path Width="11" Height="11" Stretch="Uniform" Fill="#B45309" Data="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                    <TextBlock Foreground="#B45309" FontSize="13" FontWeight="Bold" Text="{Binding TmdbRatingText}" />
                                  </StackPanel>
                                </Border>
                                <Border Classes="ratingBadge" IsVisible="{Binding HasDoubanRating}">
                                  <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Path Width="11" Height="11" Stretch="Uniform" Fill="#157A33" Data="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                    <TextBlock Foreground="#157A33" FontSize="13" FontWeight="Bold" Text="{Binding DoubanRatingText}" />
                                  </StackPanel>
                                </Border>
                              </StackPanel>
                            </Grid>
                          </Button>
                          <StackPanel Classes="posterQuickActions" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="6" Margin="0,8,8,0">
<Button Classes="posterQuickAction" Command="{Binding $parent[UserControl].DataContext.OpenPosterScrapeCommand}" CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource L092}" IsVisible="{Binding !IsFolder}">
<Path Width="15" Height="15" Data="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
</Button>
<Button Classes="posterQuickAction" Command="{Binding $parent[UserControl].DataContext.OpenPosterEditCommand}" CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource L144}" IsVisible="{Binding !IsFolder}">
<Path Width="15" Height="15" Data="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
</Button>
<Button Classes="posterQuickAction" Command="{Binding $parent[UserControl].DataContext.EditHomeFolderPosterCommand}" CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource L144}" IsVisible="{Binding IsFolder}">
<Path Width="15" Height="15" Data="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
</Button>
                          </StackPanel>
                          <Button Classes="offlineCacheAction" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding $parent[UserControl].DataContext.CachePosterItemCommand}" CommandParameter="{Binding}" IsVisible="{Binding $parent[UserControl].DataContext.IsHomeOfflineCacheModeActive}" ToolTip.Tip="{Binding OfflineCacheTip}">
                            <Grid Width="58" Height="58">
                              <TextBlock Classes="offlineCacheGlyph" Text="{Binding OfflineCacheGlyph}" IsVisible="{Binding ShowOfflineCacheIcon}" />
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="46" Spacing="4" IsVisible="{Binding ShowOfflineCacheProgress}">
                                <TextBlock Foreground="{DynamicResource MediaOverlayBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Text="{Binding OfflineCachePercentText}" />
                                <ProgressBar Classes="offlineCacheProgress" Value="{Binding OfflineCacheProgress}" />
                              </StackPanel>
                            </Grid>
                          </Button>
                        </Grid>
                        <StackPanel Width="{Binding $parent[UserControl].LibraryPosterCardWidth}" Spacing="0">
                          <Button Classes="cardButton" IsVisible="{Binding !IsFolder}" Command="{Binding $parent[UserControl].DataContext.OpenDetailCommand}" CommandParameter="{Binding}" IsEnabled="{Binding !$parent[UserControl].DataContext.IsHomeOfflineCacheModeActive}">
                            <TextBlock Margin="0,10,0,0" Width="{Binding $parent[UserControl].LibraryPosterCardWidth}" MinHeight="34" FontSize="{Binding $parent[UserControl].LibraryPosterTitleFontSize}" FontWeight="SemiBold" LineHeight="21" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Title}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                          </Button>
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !IsFolder}">
                            <Button Classes="cardButton" Command="{Binding $parent[UserControl].DataContext.OpenDetailCommand}" CommandParameter="{Binding}" IsEnabled="{Binding !$parent[UserControl].DataContext.IsHomeOfflineCacheModeActive}">
                              <TextBlock Width="{Binding $parent[UserControl].LibraryPosterSubtitleWidth}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextAlignment="Center" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button Classes="watchStateButton" Command="{Binding $parent[UserControl].DataContext.OpenPosterWatchStateConfirmationCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding WatchStateText}">
                              <ContentControl Template="{StaticResource WatchStateGlyphTemplate}" />
                            </Button>
                          </StackPanel>
                          <!-- 分类文件夹：名称与数量同行，没有观影状态按钮（对齐 mac 版） -->
                          <Button Classes="cardButton" HorizontalContentAlignment="Center" IsVisible="{Binding IsFolder}" Command="{Binding $parent[UserControl].DataContext.OpenDetailCommand}" CommandParameter="{Binding}">
                            <!-- 外层 Grid 固定为海报宽度，居中不再依赖按钮内容对齐 -->
                            <Grid Width="{Binding $parent[UserControl].LibraryPosterCardWidth}">
                              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0" Height="20" HorizontalAlignment="Center">
                                <TextBlock FontSize="{Binding $parent[UserControl].LibraryPosterTitleFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="{Binding $parent[UserControl].LibraryPosterSubtitleWidth}" VerticalAlignment="Center" />
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding FolderCountText}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                              </StackPanel>
                            </Grid>
                          </Button>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl x:Name="LibrarySkeletonPanel" Margin="{Binding $parent[UserControl].LibraryWallMargin}" IsVisible="{Binding ShowLibrarySkeleton}" ItemsSource="{Binding SkeletonItems}" Loaded="LibrarySkeletonPanel_OnLoaded">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="{Binding $parent[UserControl].LibraryPosterItemWidth}" ItemHeight="{Binding $parent[UserControl].LibraryPosterItemHeight}" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Width="{Binding $parent[UserControl].LibraryPosterCardWidth}" Margin="0,0,0,14" Spacing="8">
                      <Border Classes="skeletonCard" Width="{Binding $parent[UserControl].LibraryPosterCardWidth}" Height="{Binding $parent[UserControl].LibraryPosterCardHeight}" />
                      <Border Classes="skeletonBar" Height="14" Margin="2,0" />
                      <Border Classes="skeletonBar" Height="12" Width="120" HorizontalAlignment="Left" Margin="2,0" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,48,0,32" IsVisible="{Binding ShowLibraryEmptyState}">
                <Path Width="44" Height="44" Stretch="Uniform" StrokeThickness="1.5" Stroke="{DynamicResource TextFaintBrush}" StrokeLineCap="Round" Data="M19 4H5c-1.11 0-2 .9-2 2v12c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2z M10 9l5 3-5 3V9z" />
                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Text="{Binding LibraryEmptyTitleText}" />
                <TextBlock FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center" Text="{Binding LibraryEmptyHintText}" />
              </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- 详情页 -->
    <Border Grid.Row="0" Classes="detailSurface" IsVisible="{Binding IsDetailOpen}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="DetailContentStack" Margin="44,28,44,36" Spacing="28">
          
          <!-- ====== 重绘详情页精美返回按钮 ====== -->
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Classes="iconCircle" Command="{Binding CloseDetailCommand}">
              <Path Data="M19 12H5 M12 19l-7-7 7-7" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Width="18" Height="18" Stretch="Uniform" />
            </Button>
            <Button Grid.Column="2" Classes="iconCircle" Command="{Binding ToggleDetailOfflineCacheModeCommand}" ToolTip.Tip="{DynamicResource L129}">
              <Path Data="M12 3v12m0 0l-5-5m5 5l5-5 M5 21h14" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Width="18" Height="18" Stretch="Uniform" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="340,*">
            <Grid Width="340" Height="510" HorizontalAlignment="Left">
              <Border Classes="posterShell" CornerRadius="12" />
              <Rectangle RadiusX="12" RadiusY="12">
                <Rectangle.Fill><ImageBrush Source="{Binding DetailPosterPath, Converter={StaticResource ImagePathToBitmapConverter}, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" /></Rectangle.Fill>
              </Rectangle>
              <Button Classes="offlineCacheAction" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding CacheDetailPosterCommand}" IsVisible="{Binding IsDetailOfflineCacheModeActive}" ToolTip.Tip="{Binding DetailPosterOfflineCacheTip}">
                <Grid Width="58" Height="58">
                  <TextBlock Classes="offlineCacheGlyph" Text="{Binding DetailPosterOfflineCacheGlyph}" IsVisible="{Binding !ShowDetailPosterOfflineCacheProgress}" />
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="46" Spacing="4" IsVisible="{Binding ShowDetailPosterOfflineCacheProgress}">
                    <TextBlock Foreground="{DynamicResource MediaOverlayBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Text="{Binding DetailPosterOfflineCacheProgress, StringFormat={}{0:P0}}" />
                    <ProgressBar Classes="offlineCacheProgress" Value="{Binding DetailPosterOfflineCacheProgress}" />
                  </StackPanel>
                </Grid>
              </Button>
            </Grid>

            <StackPanel Grid.Column="1" Margin="36,0,0,0" Spacing="14" VerticalAlignment="Top">
              <TextBlock FontSize="44" FontWeight="Bold" LineHeight="52" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left" Text="{Binding DetailTitle}" TextWrapping="Wrap" MaxWidth="1000" />
              <WrapPanel Orientation="Horizontal">
                <Border Classes="detailMetaBadge" Margin="0,0,10,8">
                  <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding DetailMeta}" />
                </Border>
                <Border Classes="detailMetaBadge" Margin="0,0,10,8" IsVisible="{Binding HasDetailTmdbRating}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock FontSize="15" Foreground="#F5A000" Text="&#x2605;" />
                    <TextBlock FontSize="15" FontWeight="Bold" Foreground="#F5A000" Text="{Binding DetailTmdbRatingText}" />
                  </StackPanel>
                </Border>
                <Border Classes="detailMetaBadge" Margin="0,0,10,8" IsVisible="{Binding HasDetailDoubanRating}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock FontSize="15" Foreground="#157A33" Text="&#x2605;" />
<TextBlock FontSize="15" FontWeight="Bold" Foreground="#157A33" Text="{Binding DetailDoubanRatingText}" />
</StackPanel>
</Border>
</WrapPanel>
<TextBlock FontSize="15" LineHeight="24" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Text="{Binding DetailDirectorLine}" TextWrapping="Wrap" IsVisible="{Binding HasDetailDirector}" />
<TextBlock FontSize="15" LineHeight="24" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Text="{Binding DetailCastLine}" TextWrapping="Wrap" IsVisible="{Binding HasDetailCast}" />
              <TextBlock FontSize="15" LineHeight="24" Foreground="#3C3B3A" Margin="0,2,0,0" Text="{Binding DetailOverview}" TextWrapping="Wrap" />


              <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,10,0,0">
                <Button Classes="heroAction" Command="{Binding PlayPrimaryCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Classes="iconFill" Width="16" Height="16" Fill="{DynamicResource MediaOverlayBrush}" Data="M6,4 L23,14 L6,24 Z" />
                    <TextBlock FontSize="17" FontWeight="Bold" Foreground="{DynamicResource MediaOverlayBrush}" Text="{Binding DetailPrimaryActionText}" />
                  </StackPanel>
                </Button>
                <Button Classes="heroSecondary" Command="{Binding ToggleDetailWatchedCommand}" CommandParameter="{Binding DetailPrimaryFile}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="14" Height="14" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" />
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding DetailWatchedActionText}" />
                  </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding CanShowDetailPrimaryProgress}">
                  <ProgressBar Classes="libraryProgress" Width="160" Height="4" Minimum="0" Maximum="1" Value="{Binding DetailPlaybackProgressRatio}" />
                  <TextBlock FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding DetailPrimaryTimeText}" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Grid>


          <StackPanel Spacing="14" IsVisible="{Binding CanShowDetailVersions}">
            <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L120}" />
            <ItemsControl ItemsSource="{Binding DetailVersions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                    <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Command="{Binding $parent[UserControl].DataContext.SelectDetailFileCommand}" CommandParameter="{Binding PrimaryFile}" Padding="14,10">
                      <StackPanel Spacing="4">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding DisplayTitle}" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding DisplayPath}" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding DisplayStatus}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Button>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="16" IsVisible="{Binding IsDetailSeries}">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <!-- ====== 修改季数下拉框宽度 ====== -->
              <ComboBox Classes="popupSelect" MinWidth="100" Padding="12,6" ItemsSource="{Binding AvailableSeasons}" SelectedItem="{Binding SelectedSeasonOption, Mode=TwoWay}" IsVisible="{Binding HasSeasonTabs}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock FontSize="15" FontWeight="Bold" Text="{Binding StringFormat=第 {0} 季}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding !HasSeasonTabs}">
                <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding StringFormat=第 {0} 季, Path=SelectedSeason}" />
              </StackPanel>
              <Button Classes="posterQuickAction" Command="{Binding CacheSelectedSeasonCommand}" IsVisible="{Binding IsDetailOfflineCacheModeActive}" ToolTip.Tip="{DynamicResource L138}">
                <TextBlock FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="↓" />
              </Button>
              <ProgressBar Classes="libraryProgress" Width="160" Height="5" Minimum="0" Maximum="1" Value="{Binding SelectedSeasonOfflineCacheProgress}" IsVisible="{Binding ShowSelectedSeasonOfflineCacheProgress}" />
            </StackPanel>

            <ItemsControl x:Name="EpisodeItemsControl" HorizontalAlignment="Stretch" ItemsSource="{Binding DetailFiles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <layout:JustifiedWrapPanel
                      HorizontalAlignment="Stretch"
                      ItemWidth="{Binding $parent[UserControl].EpisodeThumbnailCardWidth}"
                      ItemHeight="{Binding $parent[UserControl].EpisodeThumbnailItemHeight}"
                      HorizontalSpacing="{Binding $parent[UserControl].EpisodeThumbnailSpacing}"
                      VerticalSpacing="14"
                      ItemsPerRow="{Binding $parent[UserControl].EpisodeThumbnailItemsPerRow}"
                      MinimumJustifiedItems="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Width="{Binding $parent[UserControl].EpisodeThumbnailCardWidth}" Margin="0,0,0,14" HorizontalAlignment="Center" Spacing="10">
                    <StackPanel Spacing="8">
                      <Grid Classes="posterInteractive" Width="{Binding $parent[UserControl].EpisodeThumbnailCardWidth}" Height="{Binding $parent[UserControl].EpisodeThumbnailCardHeight}" ClipToBounds="True">
                        <Button Classes="cardButton" Command="{Binding $parent[UserControl].DataContext.SelectDetailFileCommand}" CommandParameter="{Binding}">
                          <Grid Width="{Binding $parent[UserControl].EpisodeThumbnailCardWidth}" Height="{Binding $parent[UserControl].EpisodeThumbnailCardHeight}">
                          <Border Classes="posterShell" CornerRadius="8" />
                          <Rectangle RadiusX="8" RadiusY="8">
                            <Rectangle.Fill><ImageBrush Source="{Binding PreviewImagePath, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="UniformToFill" /></Rectangle.Fill>
                          </Rectangle>
                          </Grid>
                        </Button>
                        <StackPanel Classes="posterQuickActions" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="8" Margin="0,10,10,0">
                          <Button Classes="posterQuickAction" Command="{Binding $parent[UserControl].DataContext.OpenEpisodeEditCommand}" CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource L144}">
                            <Path Width="15" Height="15" Data="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                          </Button>
                        </StackPanel>
                        <Button Classes="offlineCacheAction" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding $parent[UserControl].DataContext.CacheDetailEpisodeCommand}" CommandParameter="{Binding}" IsVisible="{Binding $parent[UserControl].DataContext.IsDetailOfflineCacheModeActive}" ToolTip.Tip="{Binding OfflineCacheTip}">
                          <Grid Width="58" Height="58">
                            <TextBlock Classes="offlineCacheGlyph" Text="{Binding OfflineCacheGlyph}" IsVisible="{Binding ShowOfflineCacheIcon}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="46" Spacing="4" IsVisible="{Binding ShowOfflineCacheProgress}">
                              <TextBlock Foreground="{DynamicResource MediaOverlayBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Text="{Binding OfflineCachePercentText}" />
                              <ProgressBar Classes="offlineCacheProgress" Value="{Binding OfflineCacheProgress}" />
                            </StackPanel>
                          </Grid>
                        </Button>
                      </Grid>
                      <StackPanel Spacing="5" MinHeight="48">
                        <Grid Width="{Binding $parent[UserControl].EpisodeThumbnailCardWidth}" ColumnDefinitions="*,Auto" MinHeight="22">
                          <TextBlock FontSize="15" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding EpisodeDisplayTitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                          <ContentControl Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Template="{StaticResource WatchStateGlyphTemplate}" />
                        </Grid>
                        <TextBlock FontSize="13" Foreground="{DynamicResource TextMutedBrush}" MinHeight="18" HorizontalAlignment="Center" TextAlignment="Center" Text="{Binding EpisodeDisplaySubtitle}" TextWrapping="Wrap" MaxLines="2" IsVisible="{Binding HasEpisodeDisplaySubtitle}" />
                        <ProgressBar Classes="libraryProgress" Width="{Binding $parent[UserControl].EpisodeThumbnailCardWidth}" Height="4" Minimum="0" Maximum="1" Value="{Binding ProgressRatio}" IsVisible="{Binding ShouldShowEpisodeProgress}" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Border IsVisible="{Binding !HasDetailFiles}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
            <StackPanel Spacing="6">
              <TextBlock FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L163}" />
              <TextBlock FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Text="{DynamicResource L149}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.RowSpan="2" ZIndex="92" Background="#66000000" IsVisible="{Binding IsStartupTmdbAlertOpen}">
      <Grid>
        <Border Classes="popupPanel" Width="520" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="16">
            <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L008}" />
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{Binding StartupTmdbAlertMessage}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
              <Button Classes="sourceAction" Command="{Binding ContinueWithoutTmdbStartupScanCommand}" Content="{DynamicResource L014}" />
              <Button Classes="dangerAction" Command="{Binding OpenTmdbSettingsFromStartupAlertCommand}" Content="{DynamicResource L035}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.RowSpan="2" ZIndex="86" Background="#66000000" IsVisible="{Binding IsNetworkLoginPanelOpen}">
      <Grid>
        <Border Classes="popupPanel" Width="560" MaxHeight="720" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding NetworkLoginTitle}" />
                <Button Grid.Column="1" Classes="dangerAction" Command="{Binding CloseNetworkLoginCommand}" Content="{DynamicResource L048}" />
              </Grid>
              <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{DynamicResource L067}" IsVisible="{Binding IsNetworkCredentialFormVisible}" />
              <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L006}" Text="{Binding PendingNetworkBaseUrl}" IsVisible="{Binding IsNetworkCredentialFormVisible}" />
                            <Grid ColumnDefinitions="*,*" IsVisible="{Binding IsNetworkCredentialFormVisible}">
                <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L121}" Text="{Binding PendingNetworkUsername}" />
                <Grid Grid.Column="1" Margin="10,0,0,0" ColumnDefinitions="*,Auto">
                  <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L064}" PasswordChar="●" Text="{Binding PendingNetworkPassword}" IsVisible="{Binding !IsNetworkPasswordVisible}" />
                  <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L064}" Text="{Binding PendingNetworkPassword}" IsVisible="{Binding IsNetworkPasswordVisible}" />
                  <Button Grid.Column="1" Classes="sourceAction" Margin="8,0,0,0" Command="{Binding ToggleNetworkPasswordVisibilityCommand}" Content="{Binding NetworkPasswordVisibilityGlyph}" ToolTip.Tip="{DynamicResource L099}" />
                </Grid>
              </Grid>
              <TextBlock Opacity="0.58" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{DynamicResource L164}" IsVisible="{Binding IsNetworkCredentialFormVisible}" />
              <Button Classes="sourceAction" HorizontalAlignment="Left" Command="{Binding SaveNetworkLoginCommand}" Content="{DynamicResource L028}" IsVisible="{Binding IsNetworkCredentialFormVisible}" />
              <ItemsControl ItemsSource="{Binding NetworkShareFolders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Classes="sourceAction" Command="{Binding $parent[UserControl].DataContext.ToggleNetworkFolderStarCommand}" CommandParameter="{Binding}" Content="{Binding StarGlyph}" ToolTip.Tip="{DynamicResource L108}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="sourceAction" HorizontalAlignment="Right" Command="{Binding MountStarredNetworkFoldersCommand}" Content="{Binding MountStarredNetworkFoldersActionText}" IsVisible="{Binding HasNetworkShareFolders}" />
              <TextBlock Opacity="0.68" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{Binding NetworkSourceStatus}" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>

    <Border Grid.RowSpan="2" ZIndex="86" Background="#66000000" IsVisible="{Binding IsMediaServerPanelOpen}">
      <Grid>
        <Border Classes="popupPanel" Width="520" MaxHeight="680" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L115}" />
                <Button Grid.Column="1" Classes="dangerAction" Command="{Binding CloseMediaServerPanelCommand}" Content="{DynamicResource L048}" />
              </Grid>
              <ComboBox Classes="popupSelect" HorizontalAlignment="Stretch" ItemsSource="{Binding MediaServerProtocolOptions}" SelectedItem="{Binding SelectedMediaServerProtocolOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L100}" Text="{Binding PendingMediaServerName}" />
              <TextBox Classes="popupSearchBox" Watermark="{Binding PendingMediaServerAddressWatermark}" Text="{Binding PendingMediaServerBaseUrl}" />
              <TextBox Classes="popupSearchBox" Watermark="{Binding PendingMediaServerUserWatermark}" Text="{Binding PendingMediaServerUserId}" IsVisible="{Binding PendingMediaServerUsesUserId}" />
              <Button Classes="sourceAction" Command="{Binding AuthorizePlexCommand}" Content="{Binding PlexAuthorizeButtonText}" IsVisible="{Binding PendingMediaServerUsesPlex}" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Classes="popupSearchBox" Watermark="{Binding PendingMediaServerTokenWatermark}" PasswordChar="●" Text="{Binding PendingMediaServerToken}" IsVisible="{Binding !IsMediaServerTokenVisible}" />
                <TextBox Classes="popupSearchBox" Watermark="{Binding PendingMediaServerTokenWatermark}" Text="{Binding PendingMediaServerToken}" IsVisible="{Binding IsMediaServerTokenVisible}" />
                <Button Grid.Column="1" Classes="sourceAction" Margin="8,0,0,0" Command="{Binding ToggleMediaServerTokenVisibilityCommand}" Content="{Binding MediaServerTokenVisibilityGlyph}" ToolTip.Tip="{DynamicResource L098}" />
              </Grid>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="sourceAction" Command="{Binding AddMediaServerSourceCommand}" Content="{DynamicResource L024}" />
              </StackPanel>
              <TextBlock Opacity="0.68" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{Binding MediaServerStatus}" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>
    <Border Grid.RowSpan="2" ZIndex="86" Background="#66000000" IsVisible="{Binding IsLuckyStunSourcePanelOpen}">
      <Grid>
        <Border Classes="popupPanel" Width="520" MaxHeight="720" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding LuckyStunPanelTitle}" />
                <Button Grid.Column="1" Classes="dangerAction" Command="{Binding CloseLuckyStunSourcePanelCommand}" Content="{DynamicResource L048}" />
              </Grid>
              <TextBlock Opacity="0.68" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{DynamicResource L125}" />
              <ComboBox Classes="popupSelect" HorizontalAlignment="Stretch" ItemsSource="{Binding MediaServerProtocolOptions}" SelectedItem="{Binding LuckyStunSourceProtocolOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Spacing="5">
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{DynamicResource L003}" />
                <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L022}" Text="{Binding PendingLuckyStunManagementUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Spacing="5">
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{DynamicResource L005}" />
                <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L152}" Text="{Binding PendingLuckyStunUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Spacing="5">
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{DynamicResource L004}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L151}" PasswordChar="●" Text="{Binding PendingLuckyStunPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsVisible="{Binding !IsPendingLuckyStunPasswordVisible}" />
                  <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L151}" Text="{Binding PendingLuckyStunPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsVisible="{Binding IsPendingLuckyStunPasswordVisible}" />
                  <Button Grid.Column="1" Classes="sourceAction" Margin="8,0,0,0" Command="{Binding TogglePendingLuckyStunPasswordVisibilityCommand}" Content="{Binding PendingLuckyStunPasswordVisibilityGlyph}" ToolTip.Tip="{DynamicResource L099}" />
                </Grid>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="sourceAction" Command="{Binding TestPendingLuckyStunLoginCommand}" Content="{Binding PendingLuckyStunLoginButtonText}" />
              </StackPanel>
              <StackPanel Spacing="5">
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{DynamicResource L132}" />
                <ComboBox Classes="popupSelect" ItemsSource="{Binding Settings.LuckyStunRules}" SelectedValue="{Binding PendingLuckyStunRuleId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" IsEnabled="{Binding !IsPendingLuckyStunLoginInProgress}">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <CheckBox Foreground="{DynamicResource TextSecondaryBrush}" IsChecked="{Binding PendingLuckyStunAutoUpdate, Mode=TwoWay}" Content="{DynamicResource L141}" />
                <NumericUpDown Minimum="5" Maximum="1440" Value="{Binding PendingLuckyStunUpdateIntervalMinutes, Mode=TwoWay}" Width="110" IsEnabled="{Binding PendingLuckyStunAutoUpdate}" />
              </StackPanel>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Text="{DynamicResource L157}" ToolTip.Tip="{DynamicResource L052}" />
                <TextBox Grid.Column="1" Margin="8,0,0,0" Classes="popupSearchBox" Watermark="{DynamicResource L051}" Text="{Binding PendingLuckyStunPathSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding LuckyStunSourceCredentialLabel}" />
                  <TextBox Classes="popupSearchBox" Watermark="{Binding LuckyStunSourceUserWatermark}" Text="{Binding PendingLuckyStunServerUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsVisible="{Binding !LuckyStunSourceUsesPlex}" />
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !LuckyStunSourceUsesPlex}">
                    <TextBox Classes="popupSearchBox" Watermark="{Binding LuckyStunSourceCredentialWatermark}" PasswordChar="●" Text="{Binding PendingLuckyStunServerPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsVisible="{Binding !IsPendingLuckyStunPasswordVisible}" />
                    <TextBox Classes="popupSearchBox" Watermark="{Binding LuckyStunSourceCredentialWatermark}" Text="{Binding PendingLuckyStunServerPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsVisible="{Binding IsPendingLuckyStunPasswordVisible}" />
                    <Button Grid.Column="1" Classes="sourceAction" Margin="8,0,0,0" Command="{Binding TogglePendingLuckyStunPasswordVisibilityCommand}" Content="{Binding PendingLuckyStunPasswordVisibilityGlyph}" ToolTip.Tip="{DynamicResource L099}" />
                  </Grid>
                  <Button Classes="sourceAction" HorizontalAlignment="Left" Command="{Binding TestLuckyStunWebDavSourceCommand}" Content="{DynamicResource L126}" IsVisible="{Binding LuckyStunSourceUsesWebDav}" />
                </StackPanel>
              </Border>
              <TextBlock Opacity="0.68" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{Binding LuckyStunSourceStatus}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="sourceAction" Command="{Binding SaveLuckyStunSourceCommand}" Content="{DynamicResource L027}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>


    <Border Grid.RowSpan="2" ZIndex="90" Background="#88000000" IsVisible="{Binding IsOfflineCacheAlertOpen}">
      <Grid>
        <Border Classes="popupPanel" Width="460" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="16">
            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding OfflineCacheAlertTitle}" />
            <TextBlock FontSize="15" LineHeight="24" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding OfflineCacheAlertMessage}" TextWrapping="Wrap" />
            <Button Classes="heroAction" HorizontalAlignment="Right" Command="{Binding CloseOfflineCacheAlertCommand}" Content="{DynamicResource L128}" Padding="20,10" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.RowSpan="2" ZIndex="91" Background="#88000000" IsVisible="{Binding IsCancelOfflineCacheConfirmationOpen}">
      <Grid>
        <Border Classes="popupPanel" Width="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="16">
            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L049}" />
            <TextBlock FontSize="15" LineHeight="24" Foreground="{DynamicResource TextMutedBrush}" Text="{DynamicResource L069}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,8,0,0">
              <Button Classes="sourceAction" Command="{Binding KeepOfflineCacheCommand}" Content="{DynamicResource L137}" />
              <Button Classes="heroAction" Command="{Binding ConfirmCancelOfflineCacheCommand}" Content="{DynamicResource L050}" Padding="20,10" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.RowSpan="2" ZIndex="92" Background="#88000000" IsVisible="{Binding IsRemoveSourceConfirmationOpen}">
      <Grid>
        <Border Classes="popupPanel" Width="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="16">
            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L131}" />
            <TextBlock FontSize="15" LineHeight="24" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{Binding RemoveSourceConfirmationBody}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,8,0,0">
              <Button Classes="sourceAction" Command="{Binding CancelRemoveSourceConfirmationCommand}" Content="{DynamicResource L048}" />
              <Button Classes="dangerAction" Command="{Binding ConfirmRemoveSourceCommand}" Content="{DynamicResource L130}" Padding="20,10" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.RowSpan="2" ZIndex="85" Background="#88000000" IsVisible="{Binding IsPosterWatchStateConfirmationOpen}">
      <Grid>
        <Border Classes="popupPanel" Width="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="16">
            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding PosterWatchStateConfirmationTitle}" />
            <TextBlock FontSize="15" LineHeight="24" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding PosterWatchStateConfirmationMessage}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,8,0,0">
              <Button Classes="sourceAction" Command="{Binding CancelPosterWatchStateConfirmationCommand}" Content="{DynamicResource L048}" />
              <Button Classes="heroAction" Command="{Binding ConfirmPosterWatchStateCommand}" Padding="20,10">
                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MediaOverlayBrush}" Text="{Binding PosterWatchStateConfirmationActionText}" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.RowSpan="2" ZIndex="80" Background="#88000000" IsVisible="{Binding IsPosterScrapePanelOpen}">
      <Grid>
        <Border Classes="popupPanel" Width="800" MaxHeight="720" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                  <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding PosterPanelTitle}" />
                  <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{DynamicResource L087}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="sourceAction" Command="{Binding ClosePosterScrapeCommand}" Content="{DynamicResource L035}" VerticalAlignment="Top" />
              </Grid>

              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <StackPanel Spacing="6">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFaintBrush}" Text="{DynamicResource L119}" />
                  <TextBlock FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding PosterSourceFileText}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <StackPanel Spacing="10">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFaintBrush}" Text="{DynamicResource L155}" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L154}" Text="{Binding PosterDoubanSubject}" />
                    <Button Grid.Column="1" Margin="10,0,0,0" Classes="heroAction" Command="{Binding BindPosterDoubanCommand}" Content="{DynamicResource L135}" Padding="14,8" FontSize="14" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="networkLinkAction" Command="{Binding OpenPosterDoubanSearchCommand}" Content="{DynamicResource L057}" />
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Text="{DynamicResource L083}" />
                  </StackPanel>
                  <TextBlock FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding PosterDoubanStatus}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasPosterDoubanBinding}">
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Text="{Binding PosterDoubanBindingSummary, StringFormat=当前绑定：{0}}" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                    <Button Classes="dangerAction" Command="{Binding UnbindPosterDoubanCommand}" Content="{DynamicResource L146}" Padding="12,6" FontSize="13" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="*,120,Auto">
                <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L160}" Text="{Binding PosterScrapeQuery}" />
                <TextBox Grid.Column="1" Margin="10,0,0,0" Classes="popupSearchBox" Watermark="{DynamicResource L012}" Text="{Binding PosterScrapeYear}" />
                <Button Grid.Column="2" Margin="10,0,0,0" Classes="heroAction" Command="{Binding SearchPosterMetadataCandidatesCommand}" Content="{DynamicResource L091}" Padding="16,8" FontSize="15" />
              </Grid>

              <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{Binding PosterScrapeStatus}" TextWrapping="Wrap" />

              <ItemsControl ItemsSource="{Binding PosterMetadataCandidates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                      <Grid ColumnDefinitions="76,*,Auto">
                        <Border Width="76" Height="114" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource SurfaceAltBrush}">
                          <Rectangle><Rectangle.Fill><ImageBrush Source="{Binding PreviewImagePath, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="UniformToFill" /></Rectangle.Fill></Rectangle>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" Spacing="6">
                          <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Title}" TextWrapping="Wrap" />
                          <TextBlock FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding OriginalTitleText}" TextWrapping="Wrap" IsVisible="{Binding HasOriginalTitle}" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Classes="detailMetaBadge" Padding="8,4"><TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding MediaTypeText}" /></Border>
                            <TextBlock FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" Text="{Binding MatchMetaText}" />
                          </StackPanel>
                          <TextBlock FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding OverviewText}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="sourceAction" Command="{Binding $parent[UserControl].DataContext.ApplyPosterMetadataCandidateCommand}" CommandParameter="{Binding}" Content="{DynamicResource L034}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>

    <Border Grid.RowSpan="2" ZIndex="80" Background="#88000000" IsVisible="{Binding IsPosterEditPanelOpen}">
      <Grid>
        <Border Classes="popupPanel" Width="640" MaxHeight="720" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                  <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding PosterPanelTitle}" />
                  <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{DynamicResource L026}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="sourceAction" Command="{Binding ClosePosterEditCommand}" Content="{DynamicResource L048}" VerticalAlignment="Top" />
              </Grid>

              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <StackPanel Spacing="5">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFaintBrush}" Text="{DynamicResource L119}" />
                  <TextBlock FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding PosterSourceFileText}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L053}" />
                <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L076}" Text="{Binding PosterEditTitle}" />
              </StackPanel>

              <Grid ColumnDefinitions="*,140">
                <StackPanel Spacing="8">
                  <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L071}" />
                  <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L021}" Text="{Binding PosterEditDate}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="8">
                  <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L148}" />
                  <TextBox Classes="popupSearchBox" Watermark="0.0 - 10.0" Text="{Binding PosterEditVoteAverage}" />
                </StackPanel>
              </Grid>

              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <StackPanel Spacing="10">
                  <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L156}" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L154}" Text="{Binding PosterDoubanSubject}" />
                    <Button Grid.Column="1" Margin="10,0,0,0" Classes="sourceAction" Command="{Binding BindPosterDoubanCommand}" Content="{DynamicResource L135}" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="networkLinkAction" Command="{Binding OpenPosterDoubanSearchCommand}" Content="{DynamicResource L057}" />
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Text="{DynamicResource L083}" />
                  </StackPanel>
                  <TextBlock FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding PosterDoubanStatus}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasPosterDoubanBinding}">
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Text="{Binding PosterDoubanBindingSummary, StringFormat=当前绑定：{0}}" TextTrimming="CharacterEllipsis" MaxWidth="400" />
                    <Button Classes="dangerAction" Command="{Binding UnbindPosterDoubanCommand}" Content="{DynamicResource L146}" Padding="12,6" FontSize="13" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L134}" />
<TextBox Classes="popupSearchBox" MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap" Watermark="{DynamicResource L045}" Text="{Binding PosterEditOverview}" />
</StackPanel>

<Grid ColumnDefinitions="*,*">
                <StackPanel Spacing="8">
                  <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L065}" />
                  <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L066}" Text="{Binding PosterEditDirector}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="8">
                  <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L015}" />
                  <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L016}" Text="{Binding PosterEditCast}" />
                </StackPanel>
              </Grid>

              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L112}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L113}" Text="{Binding PosterEditPosterPath}" />
                  <Button Grid.Column="1" Margin="10,0,0,0" Classes="sourceAction" Command="{Binding ChoosePosterImageCommand}" Content="{DynamicResource L165}" />
                </Grid>
              </StackPanel>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,10,0,0">
                <Button Classes="sourceAction" Command="{Binding ClosePosterEditCommand}" Content="{DynamicResource L048}" />
                <Button Classes="heroAction" Command="{Binding SavePosterMetadataEditCommand}" Padding="20,10">
                  <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MediaOverlayBrush}" Text="{DynamicResource L029}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>

    <Border Grid.RowSpan="2" ZIndex="82" Background="#88000000" IsVisible="{Binding IsFolderPosterEditorOpen}">
      <Grid>
        <Border Classes="popupPanel" Width="740" MaxHeight="720" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="6">
                <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding FolderPosterEditorTitle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{DynamicResource L175}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="sourceAction" Command="{Binding CloseFolderPosterEditorCommand}" Content="{DynamicResource L035}" VerticalAlignment="Top" />
            </Grid>

            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" IsVisible="{Binding IsFolderPersonRenameVisible}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFaintBrush}" Text="{Binding FolderPosterEditorNameLabel}" />
                  <TextBox Classes="popupSearchBox" Watermark="{Binding FolderPosterEditorNameLabel}" Text="{Binding FolderPosterEditorDraftName}" />
                  <TextBlock FontSize="12" Foreground="{DynamicResource TextFaintBrush}" Text="{DynamicResource L181}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Margin="12,0,0,0" Classes="sourceAction" Command="{Binding RenameFolderPersonCommand}" Content="{DynamicResource L180}" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="420">
              <StackPanel Spacing="12">
                <ItemsControl ItemsSource="{Binding FolderPosterCandidates}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="132" ItemHeight="258" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="cardButton" Width="120" Margin="0,0,12,0" Command="{Binding $parent[UserControl].DataContext.SelectFolderPosterCommand}" CommandParameter="{Binding}">
                        <StackPanel Spacing="6">
                          <Panel Width="120" Height="180">
                            <Border Classes="posterShell" CornerRadius="6" />
                            <Rectangle RadiusX="6" RadiusY="6">
                              <Rectangle.Fill><ImageBrush Source="{Binding PosterPath, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="UniformToFill" /></Rectangle.Fill>
                            </Rectangle>
                            <Border Background="#CC1E293B" CornerRadius="0,0,6,6" Padding="6,4" VerticalAlignment="Bottom" IsVisible="{Binding IsCurrent}">
                              <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MediaOverlayBrush}" HorizontalAlignment="Center" Text="{DynamicResource L178}" />
                            </Border>
                          </Panel>
                          <TextBlock FontSize="13" Height="42" LineHeight="21" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Title}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                          <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding MediaKind}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{DynamicResource L179}" TextWrapping="Wrap" IsVisible="{Binding !HasFolderPosterCandidates}" />
              </StackPanel>
            </ScrollViewer>

            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
              <Button Classes="dangerAction" Command="{Binding ResetFolderPosterCommand}" Content="{DynamicResource L177}" Padding="14,8" FontSize="14" IsVisible="{Binding HasFolderPosterEditorCurrent}" />
              <Button Classes="sourceAction" Command="{Binding ChooseFolderLocalPosterCommand}" Content="{DynamicResource L176}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.RowSpan="2" ZIndex="80" Background="#88000000" IsVisible="{Binding IsEpisodeEditPanelOpen}">
      <Grid>
        <Border Classes="popupPanel" Width="600" MaxHeight="700" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                  <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding EpisodeEditPanelTitle}" />
                  <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{DynamicResource L025}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="sourceAction" Command="{Binding CloseEpisodeEditCommand}" Content="{DynamicResource L048}" VerticalAlignment="Top" />
              </Grid>

              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <StackPanel Spacing="5">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFaintBrush}" Text="{DynamicResource L119}" />
                  <TextBlock FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding EpisodeEditSourceFileText}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="*,*">
                <StackPanel Spacing="8">
                  <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L063}" />
                  <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L019}" Text="{Binding EpisodeEditSeason}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="8">
                  <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L168}" />
                  <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L018}" Text="{Binding EpisodeEditEpisode}" />
                </StackPanel>
              </Grid>

              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L070}" />
                <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L020}" Text="{Binding EpisodeEditYear}" />
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L046}" />
                <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L023}" Text="{Binding EpisodeEditSubtitle}" />
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource L038}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Classes="popupSearchBox" Watermark="{DynamicResource L039}" Text="{Binding EpisodeEditThumbnailPath}" />
                  <Button Grid.Column="1" Margin="10,0,0,0" Classes="sourceAction" Command="{Binding ChooseEpisodeThumbnailImageCommand}" Content="{DynamicResource L165}" />
                </Grid>
              </StackPanel>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,10,0,0">
                <Button Classes="sourceAction" Command="{Binding CloseEpisodeEditCommand}" Content="{DynamicResource L048}" />
                <Button Classes="heroAction" Command="{Binding SaveEpisodeEditCommand}" Padding="20,10">
                  <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MediaOverlayBrush}" Text="{DynamicResource L024}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>

    <!-- ====== 播放器悬浮层：统一 Win11 右上角控件 + 精细化 SVG 播放控制 ====== -->
    <Border x:Name="OverlayPlaybackRoot" Grid.RowSpan="2" ZIndex="100" Background="#000000" Focusable="True" IsVisible="{Binding IsPlayerOverlayOpen}" PointerMoved="Overlay_OnPointerMoved">
      <Grid Background="#000000">
        <ContentControl x:Name="OverlayPlayerSurfaceHostContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <Border x:Name="OverlayTapSurface" Background="#01000000" PointerPressed="OverlayTapSurface_OnPointerPressed" />

        <Border x:Name="OverlayWindowBorder" BorderBrush="#FF000000" BorderThickness="1" IsHitTestVisible="False" IsVisible="False" ZIndex="60" />

        <Grid x:Name="OverlayResizeLayer" IsVisible="False" ZIndex="40">
          <Border x:Name="OverlayNorthResizeGrip" Classes="overlayResizeGrip" Height="6" VerticalAlignment="Top" PointerPressed="OverlayResizeBorder_OnPointerPressed" Tag="North" />
          <Border x:Name="OverlaySouthResizeGrip" Classes="overlayResizeGrip" Height="6" VerticalAlignment="Bottom" PointerPressed="OverlayResizeBorder_OnPointerPressed" Tag="South" />
          <Border x:Name="OverlayWestResizeGrip" Classes="overlayResizeGrip" Width="6" HorizontalAlignment="Left" PointerPressed="OverlayResizeBorder_OnPointerPressed" Tag="West" />
          <Border x:Name="OverlayEastResizeGrip" Classes="overlayResizeGrip" Width="6" HorizontalAlignment="Right" PointerPressed="OverlayResizeBorder_OnPointerPressed" Tag="East" />
          <Border x:Name="OverlayNorthWestResizeGrip" Classes="overlayResizeGrip" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" PointerPressed="OverlayResizeBorder_OnPointerPressed" Tag="NorthWest" />
          <Border x:Name="OverlayNorthEastResizeGrip" Classes="overlayResizeGrip" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" PointerPressed="OverlayResizeBorder_OnPointerPressed" Tag="NorthEast" />
          <Border x:Name="OverlaySouthWestResizeGrip" Classes="overlayResizeGrip" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" PointerPressed="OverlayResizeBorder_OnPointerPressed" Tag="SouthWest" />
          <Border x:Name="OverlaySouthEastResizeGrip" Classes="overlayResizeGrip" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" PointerPressed="OverlayResizeBorder_OnPointerPressed" Tag="SouthEast" />
        </Grid>
        
        <!-- 锚点放置在左上角，弹窗使用整窗宽度并在内部右对齐窗口按钮 -->
        <Border x:Name="OverlayWindowControlsAnchor" Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0" />
        <Border x:Name="OverlayBottomPopupAnchor" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0" />

        <Popup x:Name="OverlayResizePopup" IsLightDismissEnabled="False" Placement="Center" PlacementTarget="{Binding #OverlayPlaybackRoot}" Topmost="True">
          <Grid x:Name="OverlayResizePopupLayer" Width="{Binding #OverlayPlaybackRoot.Bounds.Width}" Height="{Binding #OverlayPlaybackRoot.Bounds.Height}">
            <Border x:Name="OverlayPopupWestResizeGrip" Classes="overlayResizeGrip" Width="14" HorizontalAlignment="Left" PointerPressed="OverlayResizeBorder_OnPointerPressed" Tag="West" />
            <Border x:Name="OverlayPopupEastResizeGrip" Classes="overlayResizeGrip" Width="14" HorizontalAlignment="Right" PointerPressed="OverlayResizeBorder_OnPointerPressed" Tag="East" />
            <Border x:Name="OverlayPopupNorthResizeGrip" Classes="overlayResizeGrip" Height="10" VerticalAlignment="Top" IsHitTestVisible="False" PointerPressed="OverlayResizeBorder_OnPointerPressed" Tag="North" />
            <Border x:Name="OverlayPopupSouthResizeGrip" Classes="overlayResizeGrip" Height="10" VerticalAlignment="Bottom" IsHitTestVisible="False" PointerPressed="OverlayResizeBorder_OnPointerPressed" Tag="South" />
            <Border x:Name="OverlayPopupNorthWestResizeGrip" Classes="overlayResizeGrip" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" PointerPressed="OverlayResizeBorder_OnPointerPressed" Tag="NorthWest" />
            <Border x:Name="OverlayPopupNorthEastResizeGrip" Classes="overlayResizeGrip" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" PointerPressed="OverlayResizeBorder_OnPointerPressed" Tag="NorthEast" />
            <Border x:Name="OverlayPopupSouthWestResizeGrip" Classes="overlayResizeGrip" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" PointerPressed="OverlayResizeBorder_OnPointerPressed" Tag="SouthWest" />
            <Border x:Name="OverlayPopupSouthEastResizeGrip" Classes="overlayResizeGrip" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" PointerPressed="OverlayResizeBorder_OnPointerPressed" Tag="SouthEast" />
          </Grid>
        </Popup>

        <!-- 统一的 Windows 11 播放页右上角控制器 -->
        <Popup x:Name="OverlayWindowControlsPopup" IsLightDismissEnabled="False" Placement="BottomEdgeAlignedLeft" PlacementTarget="{Binding #OverlayWindowControlsAnchor}" Topmost="True">
          <Border x:Name="OverlayWindowControlsPanel" Width="{Binding #OverlayPlaybackRoot.Bounds.Width}" Height="40" Background="Transparent" PointerEntered="OverlayWindowControlsPanel_OnPointerEntered" PointerExited="OverlayWindowControlsPanel_OnPointerExited" PointerMoved="OverlayWindowControlsPanel_OnPointerMoved" PointerPressed="OverlayWindowControlsPanel_OnPointerPressed" IsVisible="False">
            <StackPanel Margin="0,4,4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
              <Button Classes="WinCaptionBtnOverlay" Click="OverlayMinimizeButton_OnClick" ToolTip.Tip="{DynamicResource L104}">
                <Path Data="M 0,5 H 10 V 6 H 0 Z" Fill="{DynamicResource MediaOverlayBrush}" Width="10" Height="10" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
              <Button Classes="WinCaptionBtnOverlay" Click="OverlayMaximizeButton_OnClick" ToolTip.Tip="{DynamicResource L031}">
                <Path Data="M 1,1 H 9 V 9 H 1 Z M 0,0 V 10 H 10 V 0 Z" Fill="{DynamicResource MediaOverlayBrush}" Width="10" Height="10" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
              <Button Classes="WinCaptionBtnOverlay WinCloseBtnOverlay" Click="OverlayCloseButton_OnClick" ToolTip.Tip="{DynamicResource L036}">
                <Path Data="M 1,0 L 5,4 L 9,0 L 10,1 L 6,5 L 10,9 L 9,10 L 5,6 L 1,10 L 0,9 L 4,5 L 0,1 Z" Fill="{DynamicResource MediaOverlayBrush}" Width="10" Height="10" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
            </StackPanel>
          </Border>
        </Popup>

        <Popup x:Name="OverlayWindowControlsHotZonePopup" IsLightDismissEnabled="False" Placement="BottomEdgeAlignedLeft" PlacementTarget="{Binding #OverlayWindowControlsAnchor}" Topmost="True">
          <Border x:Name="OverlayWindowControlsHotZone" Width="{Binding #OverlayPlaybackRoot.Bounds.Width}" Height="48" Background="Transparent" PointerEntered="OverlayWindowControlsHotZone_OnPointerActivity" PointerMoved="OverlayWindowControlsHotZone_OnPointerActivity" PointerPressed="OverlayWindowControlsHotZone_OnPointerPressed" />
        </Popup>

        <Popup x:Name="OverlayStatusPopup" IsLightDismissEnabled="False" Placement="Center" PlacementTarget="{Binding #OverlayPlaybackRoot}" Topmost="True">
          <Border MaxWidth="520" Padding="16,11" CornerRadius="8" Background="#CC000000" BorderBrush="#33FFFFFF" BorderThickness="1">
            <StackPanel Spacing="10">
              <ProgressBar Width="220" Height="4" IsIndeterminate="True" IsVisible="{Binding Player.IsOpeningMovie}" />
              <TextBlock Foreground="{DynamicResource MediaOverlayBrush}" Text="{Binding Player.StatusMessage}" TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding !Player.IsPlaying}" />
            </StackPanel>
          </Border>
        </Popup>

        <Popup x:Name="OverlayControlsPopup" IsLightDismissEnabled="False" Placement="TopEdgeAlignedLeft" PlacementTarget="{Binding #OverlayBottomPopupAnchor}" Topmost="True">
          <Border x:Name="OverlayControlsArea" Width="{Binding #OverlayPlaybackRoot.Bounds.Width}" PointerMoved="OverlayControlsArea_OnPointerMoved" PointerPressed="OverlayControlsArea_OnPointerPressed">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#00000000" Offset="0" />
                <GradientStop Color="#CC000000" Offset="0.34" />
                <GradientStop Color="#F2000000" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="30,46,30,30" RowDefinitions="Auto,Auto,Auto,Auto">
              <Button Grid.Row="0" MinHeight="42" Padding="18,0" HorizontalAlignment="Right" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Foreground="{DynamicResource MediaOverlayBrush}" FontWeight="SemiBold" Command="{Binding Player.PlayNextEpisodeCommand}" Content="{Binding Player.NextEpisodeActionText}" IsVisible="{Binding Player.ShouldShowNextEpisodeAction}" />

              <Grid Grid.Row="1" Margin="0,0,0,8" ColumnDefinitions="*,Auto,*">
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="24">
                  <!-- 后退按钮：双实心箭头 -->
                  <Button Classes="overlayCtrl" Width="52" Height="52" CornerRadius="26" Command="{Binding PlayerTimelineSeekBackwardCommand}" ToolTip.Tip="{DynamicResource L054}">
                    <Path Fill="{DynamicResource MediaOverlayBrush}" Stretch="Uniform" Width="20" Height="20" Data="M11.99 12L21.5 18V6l-9.51 6zm-9.5 0L12 18V6L2.49 12z" />
                  </Button>
                  <!-- 播放/暂停按钮：纯净毛玻璃底座 -->
                  <Button Width="68" Height="68" Padding="0" Background="#E6FFFFFF" BorderThickness="0" CornerRadius="34" Foreground="#111111" Command="{Binding Player.TogglePlayPauseCommand}" ToolTip.Tip="{DynamicResource L096}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Arial" Text="{Binding Player.PlayPauseGlyph}" />
                  </Button>
                  <!-- 前进按钮：双实心箭头 -->
                  <Button Classes="overlayCtrl" Width="52" Height="52" CornerRadius="26" Command="{Binding PlayerTimelineSeekForwardCommand}" ToolTip.Tip="{DynamicResource L044}">
                    <Path Fill="{DynamicResource MediaOverlayBrush}" Stretch="Uniform" Width="20" Height="20" Data="M12.01 12L2.5 6v12l9.51-6zm9.5 0L12 6v12l9.51-6z" />
                  </Button>
                </StackPanel>

              </Grid>

              <Grid Grid.Row="2" Margin="0,14,0,0" ColumnDefinitions="Auto,*,Auto">
                <TextBlock MinWidth="54" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Foreground="#E0E0E0" Text="{Binding PlayerTimelineCurrentPositionText}" />
                <Grid Grid.Column="1" Margin="12,0">
                  <Slider x:Name="OverlayPositionSlider" Minimum="0" Maximum="{Binding PlayerTimelineDurationSeconds}" Value="{Binding PlayerTimelineSeekPositionSeconds, Mode=TwoWay}" PropertyChanged="OverlaySlider_OnPropertyChanged" PointerEntered="OverlaySlider_OnPointerEntered" PointerMoved="OverlaySlider_OnPointerMoved" PointerExited="OverlaySlider_OnPointerExited" />
                  <player:SegmentedTimelineOverlay Boundaries="{Binding PlayerTimelineSegmentBoundaries}" Height="24" VerticalAlignment="Center" IsHitTestVisible="False" />
                  <Border x:Name="OverlayTimeBubble" IsVisible="False" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,-26,0,0" Background="#E61A1A1A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Padding="6,3">
                    <TextBlock x:Name="OverlayTimeBubbleText" FontFamily="Consolas" FontSize="11" Foreground="#FFFFFF" />
                  </Border>
                </Grid>
                <TextBlock Grid.Column="2" MinWidth="58" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Foreground="#E0E0E0" Text="{Binding PlayerTimelineRemainingTimeText}" />
              </Grid>

              <Grid Grid.Row="3" Margin="0,12,0,0">
                <!-- 左下角对齐：音量控制内联显示 -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                  <Button Classes="overlayCtrl" Width="40" Height="36" CornerRadius="6" Command="{Binding Player.ToggleMuteCommand}" ToolTip.Tip="{DynamicResource L169}">
                    <Grid Width="20" Height="20">
                      <!-- 正常音量 -->
                      <Path Fill="{DynamicResource MediaOverlayBrush}" Stretch="Uniform" IsVisible="{Binding !Player.IsMuted}" Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" />
                      <!-- 静音 -->
                      <Path Fill="{DynamicResource MediaOverlayBrush}" Stretch="Uniform" IsVisible="{Binding Player.IsMuted}" Data="M16.5 12A4.5 4.5 0 0 0 14 7.97v1.78l2.45 2.45c.03-.07.05-.14.05-.2zM19 12c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.916 8.916 0 0 0 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z" />
                    </Grid>
                  </Button>
                  <Slider x:Name="OverlayVolumeSlider" Width="100" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="{Binding Player.VolumePercent, Mode=TwoWay}" PropertyChanged="OverlayVolumeSlider_OnPropertyChanged" ToolTip.Tip="{Binding Player.VolumeText}" />
                </StackPanel>

                <!-- 右下角对齐：音轨和字幕控制 -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                  <!-- 音轨控制：音乐符号 -->
                  <Grid>
                    <Button x:Name="OverlayAudioButton" Classes="overlayCtrl" Width="40" Height="36" CornerRadius="6" Click="OverlayAudioButton_OnClick" IsVisible="{Binding Player.IsPlaying}" ToolTip.Tip="{DynamicResource L170}">
                      <Path Fill="{DynamicResource MediaOverlayBrush}" Stretch="Uniform" Width="18" Height="18" Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" />
                    </Button>
                    <Popup x:Name="OverlayAudioPopup" IsLightDismissEnabled="True" Placement="Top" PlacementTarget="{Binding #OverlayAudioButton}">
                      <Border MinWidth="120" MaxWidth="360" Padding="8" Background="#E61A1A1A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" PointerMoved="OverlayControlsArea_OnPointerMoved">
                        <ItemsControl ItemsSource="{Binding Player.AudioTracks}">
                          <ItemsControl.ItemTemplate><DataTemplate>
                            <Button MinHeight="36" Padding="12,0" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MediaOverlayBrush}" Click="OverlayAudioTrackButton_OnClick">
                              <Grid ColumnDefinitions="Auto,Auto">
                                <Border Grid.ColumnSpan="2" Background="#29FFFFFF" CornerRadius="5" Margin="4,1" IsVisible="{Binding IsSelected}" />
                                <TextBlock MaxWidth="320" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#0078D4" Text="✓" IsVisible="{Binding IsSelected}" />
                              </Grid>
                            </Button>
                          </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                    </Popup>
                  </Grid>

                  <!-- 字幕控制：CC符号 -->
                  <Grid>
                    <Button x:Name="OverlaySubtitleButton" Classes="overlayCtrl" Width="40" Height="36" CornerRadius="6" Click="OverlaySubtitleButton_OnClick" IsVisible="{Binding Player.HasTrackControls}" ToolTip.Tip="{DynamicResource L062}">
                      <Path Fill="{DynamicResource SurfaceBrush}" Stretch="Uniform" Width="20" Height="16" Data="M19 4H5c-1.11 0-2 .9-2 2v12c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm-8 7H9.5v-.5h-2v3h2V13H11v1.5c0 .28-.22.5-.5.5h-3c-.28 0-.5-.22-.5-.5v-4c0-.28.22-.5.5-.5h3c.28 0 .5.22.5.5V11zm7 0h-1.5v-.5h-2v3h2V13H18v1.5c0 .28-.22.5-.5.5h-3c-.28 0-.5-.22-.5-.5v-4c0-.28.22-.5.5-.5h3c.28 0 .5.22.5.5V11z" />
                    </Button>
                    <Popup x:Name="OverlaySubtitlePopup" IsLightDismissEnabled="True" Placement="Top" PlacementTarget="{Binding #OverlaySubtitleButton}">
                      <Border MinWidth="176" MaxWidth="360" Padding="12" Background="#E61A1A1A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" PointerMoved="OverlayControlsArea_OnPointerMoved">
                        <StackPanel Spacing="10">
                          <ItemsControl ItemsSource="{Binding Player.SubtitleTracks}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                              <Button MinHeight="36" Padding="12,0" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MediaOverlayBrush}" Click="OverlaySubtitleTrackButton_OnClick">
                                <Grid ColumnDefinitions="Auto,Auto">
                                  <Border Grid.ColumnSpan="2" Background="#29FFFFFF" CornerRadius="5" Margin="4,1" IsVisible="{Binding IsSelected}" />
                                  <TextBlock MaxWidth="320" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#0078D4" Text="✓" IsVisible="{Binding IsSelected}" />
                                </Grid>
                              </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                          </ItemsControl>
                          
                          <Button MinWidth="132" Height="36" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Foreground="{DynamicResource MediaOverlayBrush}" Command="{Binding Player.LoadExternalSubtitleCommand}" IsVisible="{Binding Player.HasExternalSubtitlePicker}">
                            <TextBlock Margin="12,0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{DynamicResource L047}" />
                          </Button>
                          
                          <StackPanel Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding Player.HasSubtitleStyleControls}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                              <Button Width="32" Height="32" Padding="0" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Foreground="{DynamicResource MediaOverlayBrush}" Command="{Binding Player.DecreaseSubtitleDelayCommand}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Text="-" /></Button>
                              <TextBlock Width="44" TextAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource MediaOverlayBrush}" Text="{Binding Player.SubtitleDelayText}" />
                              <Button Width="32" Height="32" Padding="0" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Foreground="{DynamicResource MediaOverlayBrush}" Command="{Binding Player.IncreaseSubtitleDelayCommand}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Text="+" /></Button>
                            </StackPanel>
                            <Grid HorizontalAlignment="Center">
                              <Button x:Name="OverlaySubtitleSizeMenuButton" MinWidth="54" MinHeight="32" Padding="12,0" HorizontalContentAlignment="Center" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Foreground="{DynamicResource MediaOverlayBrush}" Click="OverlaySubtitleSizeMenuButton_OnClick" Content="{DynamicResource L059}" />
                              <Popup x:Name="OverlaySubtitleSizePopup" IsLightDismissEnabled="True" Placement="Top" PlacementTarget="{Binding #OverlaySubtitleSizeMenuButton}">
                                <Border Padding="6" Background="#E61A1A1A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" PointerMoved="OverlayControlsArea_OnPointerMoved">
                                  <ItemsControl ItemsSource="{Binding Player.SubtitleSizeOptions}">
                                    <ItemsControl.ItemTemplate><DataTemplate><Button MinWidth="54" MinHeight="32" Padding="10,0" HorizontalContentAlignment="Center" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Foreground="{DynamicResource MediaOverlayBrush}" Click="OverlaySubtitleSizeButton_OnClick" Content="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </Border>
                              </Popup>
                            </Grid>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </Popup>
                  </Grid>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Popup>

        <Popup x:Name="OverlayBottomHotZonePopup" IsLightDismissEnabled="False" Placement="TopEdgeAlignedLeft" PlacementTarget="{Binding #OverlayBottomPopupAnchor}" Topmost="True">
          <Border x:Name="OverlayBottomHotZone" Width="{Binding #OverlayPlaybackRoot.Bounds.Width}" Height="180" Background="#01000000" PointerEntered="OverlayBottomHotZone_OnPointerActivity" PointerMoved="OverlayBottomHotZone_OnPointerActivity" PointerPressed="OverlayBottomHotZone_OnPointerPressed" />
        </Popup>
      </Grid>
    </Border>

    <!-- 全局 Toast 通知 -->
    <ItemsControl Grid.Row="0" IsHitTestVisible="False" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="52,96,0,0" IsVisible="{Binding !IsDetailOpen}" ItemsSource="{Binding Toasts}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Vertical" HorizontalAlignment="Left" Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="toastCard">
            <Grid ColumnDefinitions="4,12,*,Auto" MinWidth="240" MaxWidth="420">
              <Border Grid.Column="0" Background="#157A33" IsVisible="{Binding IsSuccess}" />
              <Border Grid.Column="0" Background="{DynamicResource DangerBrush}" IsVisible="{Binding IsError}" />
              <Border Grid.Column="0" Background="{DynamicResource AccentBrush}" IsVisible="{Binding IsInfo}" />
              <Path Grid.Column="1" Width="16" Height="16" Stretch="Uniform" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" Stroke="#157A33" IsVisible="{Binding IsSuccess}" Data="M20 6L9 17l-5-5" />
              <Path Grid.Column="1" Width="16" Height="16" Stretch="Uniform" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" Stroke="{DynamicResource DangerBrush}" IsVisible="{Binding IsError}" Data="M12 8v4 M12 16h.01 M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z" />
              <Path Grid.Column="1" Width="16" Height="16" Stretch="Uniform" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}" IsVisible="{Binding IsInfo}" Data="M12 16v-4 M12 8h.01 M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z" />
              <TextBlock Grid.Column="2" Classes="toastText" VerticalAlignment="Center" Margin="2,10,12,10" Text="{Binding Text}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
